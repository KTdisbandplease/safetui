info_cmd_text() {
    local ko=1; [[ "$LANG_MODE" == "en" ]] && ko=0
    local db="$BK_DB_HOME/bin"
    if (( ko )); then cat <<EOF
메뉴 화면(TUI)을 쓸 수 없을 때 같은 일을 명령으로 하는 방법입니다.
모두 root 권한이 필요합니다. < > 안은 상황에 맞게 바꿔 넣으세요.

EOF
    else cat <<EOF
How to do the same things with commands when the menu (TUI) cannot
be used. All need root. Replace the < > parts.

EOF
    fi
    cat <<EOF
==================== $( ((ko)) && echo '방화벽' || echo 'Firewall' ) ====================
# $( ((ko)) && echo '지금 상태 보기' || echo 'Show current state' )
firewall-cmd --state
firewall-cmd --get-active-zones
firewall-cmd --list-all

# $( ((ko)) && echo '포트 열기 / 닫기 (영구 저장 후 적용)' || echo 'Open / close a port (permanent, then apply)' )
firewall-cmd --permanent --add-port=8080/tcp
firewall-cmd --permanent --remove-port=8080/tcp
firewall-cmd --reload

# $( ((ko)) && echo '서비스 이름으로 열기 / 닫기' || echo 'Open / close by service name' )
firewall-cmd --permanent --add-service=https
firewall-cmd --permanent --remove-service=https
firewall-cmd --reload

# $( ((ko)) && echo '특정 IP에서만 포트 허용 (한 줄로 입력)' || echo 'Allow a port from one IP only (one line)' )
firewall-cmd --permanent --add-rich-rule='rule family="ipv4"
  source address="192.168.0.10" port port="3306" protocol="tcp" accept'
firewall-cmd --reload
# $( ((ko)) && echo '규칙 보기 / 지우기: --list-rich-rules / --remove-rich-rule=...' || echo 'List / remove: --list-rich-rules / --remove-rich-rule=...' )

==================== SELinux ====================
# $( ((ko)) && echo '상태 보기, 모드 전환 (0 = Permissive, 1 = Enforcing)' || echo 'Status, switch mode (0 = Permissive, 1 = Enforcing)' )
getenforce
sestatus
setenforce 0
setenforce 1

# $( ((ko)) && echo '포트 정책 보기 / 추가 / 삭제' || echo 'Port policy: list / add / delete' )
semanage port -l | grep http_port_t
semanage port -a -t http_port_t -p tcp 8080
semanage port -d -t http_port_t -p tcp 8080

# $( ((ko)) && echo 'Boolean 스위치 보기 / 바꾸기 (-P = 재부팅 후에도 유지)' || echo 'Booleans: show / set (-P = keep after reboot)' )
getsebool -a | grep httpd
setsebool -P httpd_can_network_connect on

# $( ((ko)) && echo '파일 컨텍스트 추가 후 실제 파일에 적용' || echo 'Add a file context, then apply it to the files' )
semanage fcontext -a -t httpd_sys_content_t '/srv/web(/.*)?'
restorecon -Rv /srv/web

# $( ((ko)) && echo '거부 로그 보기, 허용 정책 만들어 넣기 / 지우기' || echo 'Denials, build and load an allow policy / remove it' )
ausearch -m avc -ts recent
ausearch -m avc -ts recent -c <$( ((ko)) && echo '프로그램' || echo 'program' )> | audit2allow -M <$( ((ko)) && echo '이름' || echo 'name' )>
semodule -i <$( ((ko)) && echo '이름' || echo 'name' )>.pp
semodule -r <$( ((ko)) && echo '이름' || echo 'name' )>

==================== $( ((ko)) && echo '작업 안전장치' || echo 'Lockout guard' ) ====================
# $( ((ko)) && echo '켜기: 300초 안에 확정하지 않으면 방화벽을 자동 원복' || echo 'Arm: revert the firewall unless confirmed within 300s' )
safetui-guard arm --timeout 300 --targets firewall --note "<$( ((ko)) && echo '메모' || echo 'note' )>"
#   --targets : firewall,sshd,network $( ((ko)) && echo '중에서 쉼표로 (기본 all)' || echo '(comma separated, default all)' )
safetui-guard status      # $( ((ko)) && echo '상태·남은 시간' || echo 'state, time left' )
safetui-guard ok          # $( ((ko)) && echo '확정 (변경 유지)' || echo 'confirm (keep changes)' )
safetui-guard rollback    # $( ((ko)) && echo '지금 바로 되돌리기' || echo 'roll back now' )
safetui-guard log         # $( ((ko)) && echo '켬·확정·원복 기록' || echo 'history' )

==================== $( ((ko)) && echo '백업' || echo 'Backup' ) ====================
# $( ((ko)) && echo '파일·폴더를 소유자·권한 그대로 복사' || echo 'Copy a file / folder keeping owner and mode' )
cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf_\$(date +%Y%m%d)
cp -a /etc/nginx /etc/nginx_\$(date +%Y%m%d)

# $( ((ko)) && echo '여러 개를 tar 하나로 / 내용 보기 / 원래 자리에 풀기' || echo 'Bundle into one tar / list / restore in place' )
tar -C / --selinux --acls --xattrs -cpf /root/backup.tar \\
