info_menu() {
    local choice
    while true; do
        choice="$(dlg --title "$(L '정보 / 도움말' 'About / Help')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '보고 싶은 항목을 선택하세요.' 'Choose what to read.')" 12 "$DLG_W" 3 \
            1 "$(L '정보   — 기능 소개, 지원 OS' 'About    — features, supported OS')" \
            2 "$(L '도움말 — 키 조작, 작업 팁' 'Help     — keys and tips')" \
            3 "$(L '명령어 — 메뉴 없이 명령으로 하는 방법' 'Commands — doing the same without the menu')")" || return
        case "$choice" in
            1) show_page "$(L '정보' 'About')" info_about_text ;;
            2) show_page "$(L '도움말' 'Help')" info_help_text ;;
            3) bk_load; show_page "$(L '명령어' 'Commands')" info_cmd_text ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Language selection
# ---------------------------------------------------------------------------
lang_menu() {
    local choice
    choice="$(dlg --title "$(L '언어 / Language' 'Language / 언어')" --cancel-label "$(L '뒤로' 'Back')" \
        --menu "$(L '언어를 선택하세요.' 'Select a language.')" 11 "$DLG_W" 2 \
        ko "$(L '한국어' 'Korean (한국어)')" \
        en "$(L 'English (영어)' 'English')")" || return
    case "$choice" in
        ko) LANG_MODE="ko"; save_lang ;;
        en) LANG_MODE="en"; save_lang ;;
    esac
    BACKTITLE="safetui ${APP_VERSION} — $(L '방화벽·SELinux·작업 안전장치·백업' 'Firewall·SELinux·Guard·Backup')"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main_menu() {
    local rc fails=0 defbtn=ok
    while true; do
        local choice
        GOT_INT=0
        choice="$(dlg --title "$(L '메인 메뉴' 'Main menu')" --cancel-label "$(L '종료' 'Quit')" --default-button "$defbtn" \
            --menu "$(L '무엇을 관리할까요?' 'What would you like to manage?')" 17 "$DLG_W" 6 \
            1 "$(L '방화벽 관리' 'Firewall')" \
            2 "$(L 'SELinux 관리' 'SELinux')" \
            3 "$(L '작업 안전장치' 'Lockout guard')" \
            4 "$(L '백업' 'Backup')" \
            5 "$(L '언어 변경 / Language' 'Language / 언어')" \
            6 "$(L '정보 / 도움말' 'About / Help')")"
        rc=$?
        # Only the <Quit> button (1) ends the program. ESC / Ctrl+C do not quit; they just move the cursor to <Quit>
        # (so that after pressing ESC back to the main menu, Enter leads to quitting).
        if (( rc == 1 )) && (( ! GOT_INT )); then
            # If the cursor was put on <Quit> by ESC, ask once more. In that state, choosing an item with the
            # arrow keys and pressing Enter activates <Quit>, not the item (prevents quitting by accident)
            if [[ "$defbtn" == cancel ]]; then
                yesno "$(L '종료' 'Quit')" "$(L 'safetui 를 종료할까요?' 'Quit safetui?')" 7 50 || { defbtn=ok; continue; }
            fi
            break
        fi
        if (( rc != 0 )); then
            if (( rc == DIALOG_ESC || GOT_INT )); then GOT_INT=0; fails=0; defbtn=cancel; continue; fi
            # Any other code means the screen could not be drawn (terminal too small etc.). Do not loop forever; explain and exit
            if (( ++fails >= 3 )); then
                EXIT_NOTE="$(L 'safetui: 화면을 표시할 수 없어 종료했습니다. 터미널 창을 80x24 이상으로 키운 뒤 다시 실행하세요.' \
                               'safetui: could not draw the screen and exited. Enlarge the terminal to at least 80x24 and run again.') (stty size: $(stty size 2>/dev/null))"
                break
            fi
            sleep 0.3; continue
        fi
        fails=0; GOT_INT=0; defbtn=ok
        case "$choice" in
            1) firewall_menu ;;
            2) selinux_menu ;;
            3) guard_menu ;;
            4) backup_menu ;;
            5) lang_menu ;;
            6) info_menu ;;
        esac
    done
}

# ---- entrypoint ----
case "${1:-}" in
    -v|--version) echo "${APP_NAME} ${APP_VERSION}"; exit 0 ;;
    --db-backup)  need_root; bk_db_cli; exit $? ;;
    --apply-schedule)   # re-register the saved schedule in systemd (called by the package scriptlet after a package swap)
        need_root; bk_load; bk_sched_apply; exit 0 ;;
    -e|--en|--english) LANG_MODE="en"; save_lang; shift ;;
    -k|--ko|--korean)  LANG_MODE="ko"; save_lang; shift ;;
    -h|--help)
        cat <<EOF
${APP_NAME} ${APP_VERSION} — Firewall / SELinux management TUI

Usage:
  sudo ${APP_NAME}            run the menu
  sudo ${APP_NAME} --english  switch to English (persists)
  sudo ${APP_NAME} --korean   switch to Korean (persists)
  ${APP_NAME} --version       show version
  sudo ${APP_NAME} --db-backup  run the MariaDB backup once, no menu (used by the schedule)
  ${APP_NAME} --help          this help

Language can also be set via SAFETUI_LANG=en|ko, or the in-app Language menu.
Target: RHEL / Rocky / AlmaLinux 9. Requires root.
EOF
        exit 0 ;;
esac

BACKTITLE="safetui ${APP_VERSION} — $(L '방화벽·SELinux·작업 안전장치·백업' 'Firewall·SELinux·Guard·Backup')"
need_root
preflight
guard_ticker </dev/null >/dev/null 2>&1 &
TICKER_PID=$!
main_menu
