             "Select the SELinux type to apply.\n(If not listed, choose 'Custom')")" \
        "$DLG_H" "$DLG_W" "$MENU_H" \
        httpd_sys_content_t     "$(L '웹 읽기 컨텐츠 (Apache/Nginx)' 'Web content, read (Apache/Nginx)')" \
        httpd_sys_rw_content_t  "$(L '웹 읽기+쓰기 컨텐츠' 'Web content, read+write')" \
        httpd_sys_script_exec_t "$(L '웹 CGI/스크립트 실행' 'Web CGI/script exec')" \
        samba_share_t           "$(L 'Samba 공유' 'Samba share')" \
        public_content_t        "$(L '공개 읽기 (FTP 등)' 'Public read (FTP, etc.)')" \
        public_content_rw_t     "$(L '공개 읽기+쓰기' 'Public read+write')" \
        var_log_t               "$(L '로그 파일' 'Log files')" \
        container_file_t        "$(L '컨테이너 파일' 'Container files')" \
        __custom__              "$(L '직접 입력...' 'Custom...')")" || return 1
    if [[ "$sel" == "__custom__" ]]; then
        dlg_input "$(L '타입 직접 입력' 'Custom type')" "$(L '적용할 SELinux 타입을 입력하세요.\n예) mysqld_db_t' 'Enter a SELinux type.\ne.g. mysqld_db_t')"
    else
        echo "$sel"
    fi
}

se_port_add() {
    local type port proto
    type="$(se_pick_port_type)" || return
    [[ -z "$type" ]] && return
    port="$(dlg_input "$(L '포트 번호' 'Port number')" "$(L '허용할 포트 번호를 입력하세요. 예) 8080' 'Enter the port number. e.g. 8080')")" || return
    [[ -z "$port" ]] && return
    proto="$(dlg --title "$(L '프로토콜' 'Protocol')" --menu "$(L '프로토콜 선택' 'Select protocol')" 10 "$DLG_W" 2 tcp " " udp " ")" || return

    if yesno "$(L '확인' 'Confirm')" "$(L 'SELinux 포트 정책을 추가합니다.' 'Add SELinux port policy.')\n\n  $(L '타입' 'type'): $type\n  $(L '포트' 'port'): ${port}/${proto}\n\n(semanage port -a -t $type -p $proto $port)\n$(L '진행할까요?' 'Proceed?')"; then
        run_show "$(L 'SELinux 포트 정책 추가' 'Add SELinux port policy')" semanage port -a -t "$type" -p "$proto" "$port"
    fi
}

se_port_del() {
    local line type port proto
    mapfile -t rows < <(semanage port -l -C 2>/dev/null | awk 'NR>2 && NF>=3')
    if [[ ${#rows[@]} -eq 0 ]]; then
        msg "$(L 'SELinux 포트 정책 삭제' 'Remove SELinux port policy')" "$(L '사용자가 추가한(local) 포트 정책이 없습니다.\n기본 내장 정책은 삭제할 수 없습니다.' \
             'No user-added (local) port policies.\nBuilt-in policies cannot be removed.')"
        return
    fi
    local args=() i=0
    for line in "${rows[@]}"; do args+=("$i" "$line"); ((i++)); done
    local idx
    idx="$(dlg --title "$(L 'SELinux 포트 정책 삭제' 'Remove SELinux port policy')" --menu \
        "$(L '삭제할 정책을 선택하세요. (사용자 추가 정책만 표시)' 'Select a policy to remove (user-added only).')" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return
    line="${rows[$idx]}"
    type="$(awk '{print $1}' <<<"$line")"
    proto="$(awk '{print $2}' <<<"$line")"
    port="$(awk '{print $3}' <<<"$line")"
    if yesno "$(L '확인' 'Confirm')" "$(L '다음 정책을 삭제합니다.' 'Remove the following policy.')\n\n  $line\n\n(semanage port -d -t $type -p $proto $port)\n$(L '진행할까요?' 'Proceed?')"; then
        run_show "$(L 'SELinux 포트 정책 삭제' 'Remove SELinux port policy')" semanage port -d -t "$type" -p "$proto" "$port"
    fi
}

# --- SELinux Boolean ---
se_bool_view() { show_text "$(L 'SELinux Boolean 목록 (getsebool -a)' 'SELinux Booleans (getsebool -a)')" getsebool -a; }

se_pick_bool() {
    local sel b args=()
    # switches that are commonly turned on - shown with their current value
    for b in httpd_can_network_connect httpd_can_network_connect_db httpd_can_sendmail \
             httpd_use_nfs httpd_enable_homedirs httpd_unified samba_enable_home_dirs \
             ftpd_full_access nis_enabled; do
        getsebool "$b" >/dev/null 2>&1 || continue
        local cur desc
        cur="$(getsebool "$b" 2>/dev/null | awk '{print $NF}')"
        case "$b" in
            httpd_can_network_connect)    desc="$(L '웹서버 → 다른 서버(API/WAS)로 접속' 'Web server → connect to other servers')" ;;
            httpd_can_network_connect_db) desc="$(L '웹서버 → DB 서버로 접속' 'Web server → connect to DB')" ;;
            httpd_can_sendmail)           desc="$(L '웹서버 → 메일 발송' 'Web server → send mail')" ;;
            httpd_use_nfs)                desc="$(L '웹서버 → NFS 경로 사용' 'Web server → use NFS')" ;;
            httpd_enable_homedirs)        desc="$(L '웹서버 → 사용자 홈디렉토리 제공' 'Web server → serve home dirs')" ;;
            httpd_unified)                desc="$(L '웹서버 → 컨텐츠 읽기/쓰기/실행 통합 허용' 'Web server → unified content access')" ;;
            samba_enable_home_dirs)       desc="$(L 'Samba → 홈디렉토리 공유' 'Samba → share home dirs')" ;;
            ftpd_full_access)             desc="$(L 'FTP → 파일시스템 전체 접근' 'FTP → full filesystem access')" ;;
            nis_enabled)                  desc="$(L 'NIS/임의 포트 네트워크 사용 허용' 'NIS / arbitrary network ports')" ;;
        esac
        args+=("$b" "[$cur] $desc")
    done
    args+=("__custom__" "$(L '직접 입력...' 'Custom...')")
    sel="$(dlg --title "$(L 'Boolean 스위치 선택' 'Select Boolean')" --menu \
        "$(L "바꿀 스위치를 고르세요. [ ] 안은 현재 값입니다.\n(목록에 없으면 '직접 입력')" \
             "Pick a switch. [ ] shows the current value.\n(If not listed, choose 'Custom')")" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return 1
    if [[ "$sel" == "__custom__" ]]; then
        dlg_input "$(L 'Boolean 직접 입력' 'Custom Boolean')" \
            "$(L "변경할 Boolean 이름을 입력하세요.\n예) httpd_can_network_connect\n\n전체 목록은 'Boolean 스위치 보기'에서 확인." \
                 "Enter the Boolean name.\ne.g. httpd_can_network_connect\n\nSee 'View Booleans' for the full list.")"
    else
        echo "$sel"
    fi
}

se_bool_set() {
    local name state
    name="$(se_pick_bool)" || return
    [[ -z "$name" ]] && return
    if ! getsebool "$name" >/dev/null 2>&1; then
        msg "$(L 'Boolean 변경' 'Change Boolean')" "$(L "'$name' 이라는 Boolean 을 찾을 수 없습니다." "Boolean '$name' not found.")"
        return
    fi
    state="$(dlg --title "$(L 'Boolean 값' 'Boolean value')" --menu "$(L '현재' 'Current'): $(getsebool "$name")\n\n$(L '설정할 값을 선택하세요.' 'Select a value.')" 12 "$DLG_W" 2 \
        on  "$(L '허용(on)' 'on (allow)')" off "$(L '차단(off)' 'off (deny)')")" || return
    if yesno "$(L '확인' 'Confirm')" "$(L 'Boolean 을 영구(-P) 변경합니다.' 'Change Boolean permanently (-P).')\n\n  $name -> $state\n\n$(L '진행할까요?' 'Proceed?')"; then
        run_show "$(L 'Boolean 변경' 'Change Boolean')" setsebool -P "$name" "$state"
    fi
}

# --- file contexts ---
se_fcontext_view() { show_text "$(L 'SELinux 파일 컨텍스트 (사용자 추가분)' 'SELinux file contexts (user-added)')" semanage fcontext -l -C; }

se_fcontext_add() {
    local path type
    path="$(dlg_input "$(L '파일 컨텍스트 추가' 'Add file context')" \
        "$(L '컨텍스트를 지정할 경로 패턴을 입력하세요.\n예) /srv/myweb(/.*)?   (myweb 폴더 이하 전체)' \
             'Enter the path pattern for the context.\ne.g. /srv/myweb(/.*)?   (everything under myweb)')")" || return
    [[ -z "$path" ]] && return
    type="$(se_pick_fcontext_type)" || return
    [[ -z "$type" ]] && return

    local base="${path%%(*}"
    # restorecon -R is recursive: entering a top-level system path by mistake could
    # relabel the whole server (or a large part of it) - ask again in that case.
    case "$base" in
        /|/etc|/etc/|/usr|/usr/|/bin|/bin/|/sbin|/sbin/|/lib|/lib/|/lib64|/lib64/|/var|/var/|/boot|/boot/|/root|/root/|/home|/home/)
            yesno "$(L '[주의] 넓은 범위 적용' '[CAUTION] Wide scope')" \
                "$(L "입력한 경로 '$base' 는 시스템 최상위급 디렉토리입니다.\nrestorecon -R 을 여기서 실행하면 그 아래 전체가 재라벨링됩니다.\n\n정말 계속하시겠습니까?" \
                     "The path '$base' is a top-level system directory.\nrestorecon -R here will relabel everything under it.\n\nAre you sure you want to continue?")" || return
            ;;
    esac

    if yesno "$(L '확인' 'Confirm')" "$(L '파일 컨텍스트 규칙을 추가하고 적용(restorecon)합니다.' 'Add the file-context rule and apply (restorecon).')\n\n  $(L '경로' 'path'): $path\n  $(L '타입' 'type'): $type\n  $(L '재귀 적용 대상' 'recursive target'): $base\n\n$(L '진행할까요?' 'Proceed?')"; then
        if semanage fcontext -a -t "$type" "$path" >"$TMP_OUT" 2>&1; then
            restorecon -Rv "$base" >>"$TMP_OUT" 2>&1
            local nrel
            nrel="$(grep -c '^Relabeled' "$TMP_OUT")"
            if [[ "$nrel" -gt 0 ]]; then
                msg "$(L '파일 컨텍스트 추가 — 성공' 'Add file context — OK')" "$(L "규칙을 등록하고, $base 아래 파일 ${nrel}개의 라벨을 $type 로 바꿨습니다.\n앞으로 이 경로에 새로 만드는 파일에도 같은 라벨이 붙습니다." "Rule added; relabeled ${nrel} file(s) under $base to $type.\nNew files under this path will get the same label.")\n\n$(L '바뀐 파일' 'Relabeled'):\n$(cat "$TMP_OUT")"
            else
                msg "$(L '파일 컨텍스트 추가 — 성공' 'Add file context — OK')" "$(L "규칙을 등록했습니다. ($path → $type)\n\n$base 아래 파일은 이미 알맞은 라벨이라 바뀐 파일이 없습니다.\n(폴더가 아직 없다면, 나중에 만들 때 이 라벨이 붙습니다)" "Rule added ($path → $type).\n\nFiles under $base already have the right label; nothing changed.\n(If the folder does not exist yet, it will get this label when created)")" 12
            fi
        else
            msg "$(L '파일 컨텍스트 추가 — 실패' 'Add file context — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

se_fcontext_del() {
    mapfile -t rows < <(semanage fcontext -l -C 2>/dev/null | awk 'NF>=2 && $1 ~ /^\//')
    if [[ ${#rows[@]} -eq 0 ]]; then
        msg "$(L '파일 컨텍스트 삭제' 'Remove file context')" "$(L '사용자가 추가한 파일 컨텍스트 규칙이 없습니다.' 'No user-added file-context rules.')"
        return
    fi
    local args=() i=0 line
    for line in "${rows[@]}"; do args+=("$i" "$line"); ((i++)); done
    local idx
    idx="$(dlg --title "$(L '파일 컨텍스트 삭제' 'Remove file context')" --menu "$(L '삭제할 규칙을 선택하세요.' 'Select a rule to remove.')" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return
    local path
    path="$(awk '{print $1}' <<<"${rows[$idx]}")"
    if yesno "$(L '확인' 'Confirm')" "$(L '다음 파일 컨텍스트 규칙을 삭제합니다.' 'Remove the following file-context rule.')\n\n  $path\n\n$(L '진행할까요?' 'Proceed?')"; then
        run_show "$(L '파일 컨텍스트 삭제' 'Remove file context')" semanage fcontext -d "$path"
    fi
}

# --- audit2allow ---
se_audit2allow() {
    if ! need_cmd audit2allow; then
        msg "$(L '허용 정책 생성' 'Generate allow policy')" "$(L 'audit2allow 가 없습니다. (dnf install policycoreutils-python-utils)' 'audit2allow not found. (dnf install policycoreutils-python-utils)')"
        return
    fi
    # --input-logs: always read the log files, even when stdin is not a terminal
    ausearch --input-logs -m avc,user_avc -ts recent >"$TMP_OUT" 2>&1
    if ! grep -q "type=AVC\|type=USER_AVC" "$TMP_OUT" 2>/dev/null; then
        msg "$(L '허용 정책 생성' 'Generate allow policy')" "$(L '최근 10분 안에 SELinux 거부(denial) 기록이 없습니다.\n\n먼저 문제가 되는 작업을 한 번 실행해\n거부 로그를 남긴 뒤 바로 다시 시도하세요.' \
             'No SELinux denials in the last 10 minutes.\n\nRun the failing operation once to produce a\ndenial, then try again right away.')" 11
        return
    fi
    fold -s -w "$((DLG_W-6))" "$TMP_OUT" >"$TMP_OUT.f" && mv -f "$TMP_OUT.f" "$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" --title "$(L '최근 SELinux 거부 로그' 'Recent SELinux denials')" \
        --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"

    # Choose which program's denials to allow - allowing all recent denials at once
    # easily grants permissions to programs that have nothing to do with the problem.
    local args=() comm cnt sel
    while read -r cnt comm; do
        [[ -z "$comm" ]] && continue
        args+=("$comm" "$(L "거부 ${cnt}건" "${cnt} denial(s)")")
    done < <(ausearch --input-logs -m avc,user_avc -ts recent 2>/dev/null \
                | grep -E "type=(USER_)?AVC" | grep -o ' comm="[^"]*"' | sed 's/ comm="\(.*\)"/\1/' \
                | sort | uniq -c | sort -rn)
    args+=("__all__" "$(L '전체 (권장하지 않음)' 'All (not recommended)')")
    sel="$(dlg --title "$(L '허용할 프로그램 선택' 'Select the program to allow')" --menu \
        "$(L "어떤 프로그램이 막힌 문제를 해결하려는지 고르세요.\n고른 프로그램의 거부만 허용 정책에 들어갑니다.\n(예: 웹서버 문제면 httpd / nginx)" \
             "Which program's denials are you fixing?\nOnly the selected program's denials go into the policy.\n(e.g. httpd / nginx for a web server issue)")" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return

    local denials="$TMP_OUT.avc"
    if [[ "$sel" == "__all__" ]]; then
        ausearch --input-logs -m avc,user_avc -ts recent >"$denials" 2>/dev/null
    else
        ausearch --input-logs -m avc,user_avc -ts recent -c "$sel" >"$denials" 2>/dev/null
    fi

    local modname
    modname="$(dlg_input "$(L '허용 정책 생성' 'Generate allow policy')" \
        "$(L '선택한 거부들을 허용하는 정책 모듈을 만듭니다.\n모듈 이름을 정하세요. 예) mywebfix' \
             'Create a policy module allowing the selected denials.\nName the module. e.g. mywebfix')")" || { rm -f "$denials"; return; }
    [[ -z "$modname" ]] && { rm -f "$denials"; return; }

    # The module name is used as a file name (audit2allow -M / semodule -i), so path
    # characters such as '/' or '..' could write outside the work directory or load a
    # policy (.pp) from an arbitrary path - allow letters, digits, underscore and hyphen only.
    while [[ ! "$modname" =~ ^[A-Za-z0-9_-]+$ ]]; do
        modname="$(dlg_input "$(L '허용 정책 생성 — 잘못된 이름' 'Generate allow policy — invalid name')" \
            "$(L "모듈 이름에는 영문자/숫자/밑줄(_)/하이픈(-)만 사용할 수 있습니다.\n(경로 문자 '/', '..' 등은 사용할 수 없음)\n\n다시 입력하세요. 예) mywebfix" \
                 "Module name may only contain letters, digits, underscore(_) or hyphen(-).\n(Path characters like '/', '..' are not allowed)\n\nEnter it again. e.g. mywebfix")")" || { rm -f "$denials"; return; }
        [[ -z "$modname" ]] && { rm -f "$denials"; return; }
    done

    # Use the same denial records (file) for the preview and the real run, so new denials cannot slip in between
    audit2allow -m "$modname" <"$denials" >"$TMP_OUT" 2>&1
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" --title "$(L '생성될 정책 미리보기' 'Policy preview') ($modname.te)" \
        --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"

    if yesno "$(L '확인' 'Confirm')" "$(L '위 정책을 실제로 컴파일하여 시스템에 적용할까요?' 'Compile and apply this policy to the system?')\n\n  $(L '모듈' 'module'): $modname\n\n$(L '(주의: allow 줄이 해결하려는 프로그램에 대한 것인지\n 미리보기에서 꼭 확인하세요)' '(Caution: check in the preview that the allow lines\n are only for the program you are fixing)')" 12; then
        local wd; wd="$(mktemp -d /tmp/safetui-se.XXXXXX)"
        (
            cd "$wd" || exit 1
            audit2allow -M "$modname" <"$denials" >/dev/null || exit 1
            semodule -i "${modname}.pp"
        ) >"$TMP_OUT" 2>&1
        local rc=$?
        rm -rf "$wd"
        if [[ $rc -eq 0 ]]; then
            msg "$(L '허용 정책 적용 — 성공' 'Apply allow policy — OK')" "$(L "정책 모듈 '$modname' 을 시스템에 적용했습니다.\n재부팅 후에도 유지됩니다.\n\n되돌리려면: SELinux 관리 → 설치된 정책 모듈 삭제\n(또는 semodule -r $modname)" "Policy module '$modname' has been applied.\nIt persists across reboots.\n\nTo undo: SELinux → Remove installed policy module\n(or semodule -r $modname)")\n\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '허용 정책 적용 — 실패' 'Apply allow policy — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
    rm -f "$denials"
}

se_module_del() {
    # Show only modules installed by the user with semodule -i / audit2allow (priority 400).
    # Removing base (100) or package (200) modules can break services, so they are not listed.
    mapfile -t mods < <(semodule --list-modules=full 2>/dev/null | awk '$1==400{print $2}')
    if [[ ${#mods[@]} -eq 0 ]]; then
        msg "$(L '정책 모듈 삭제' 'Remove policy module')" \
            "$(L "직접 설치한 정책 모듈이 없습니다.\n\n(시스템 기본 모듈은 실수로 지우지 않도록 목록에 표시하지 않습니다)" \
                 "No user-installed policy modules.\n\n(System modules are hidden to prevent accidental removal)")" 10
        return
    fi
    local args=() m
    for m in "${mods[@]}"; do args+=("$m" "$(L '직접 설치한 모듈' 'user-installed')"); done
    local mod
    mod="$(dlg --title "$(L '정책 모듈 삭제' 'Remove policy module')" --menu \
        "$(L '삭제할 정책 모듈을 선택하세요.\n(직접 설치한 모듈만 표시됩니다)' 'Select a policy module to remove.\n(Only user-installed modules are shown)')" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return
    if yesno "$(L '확인' 'Confirm')" "$(L '정책 모듈을 삭제합니다.' 'Remove policy module.') ($mod)\n\n$(L '진행할까요?' 'Proceed?')"; then
        run_show "$(L '정책 모듈 삭제' 'Remove policy module')" semodule -r "$mod"
    fi
}

selinux_menu() {
    if ! need_cmd getenforce; then
        msg "SELinux" "$(L 'SELinux 유틸리티가 없습니다. (dnf install libselinux-utils policycoreutils-python-utils)' 'SELinux utilities not found. (dnf install libselinux-utils policycoreutils-python-utils)')"
        return
    fi
    while true; do
