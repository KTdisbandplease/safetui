se_status() {
    {
        echo "===================================================================="
        echo " $(L 'SELinux 상태' 'SELinux status')"
        echo "===================================================================="
        echo
        echo "[ $(L '현재 동작 모드' 'Current mode') ]  $(getenforce 2>&1)"
        echo "  - Enforcing  : $(L "정책 위반을 '차단'" "block policy violations")"
        echo "  - Permissive : $(L "위반을 '기록만' 하고 허용 (문제 진단용)" "log only, do not block (for troubleshooting)")"
        echo "  - Disabled   : $(L 'SELinux 꺼짐' 'SELinux off')"
        echo
        echo "===================================================================="
        sestatus 2>&1
    } | fold -s -w "$((DLG_W-6))" >"$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" --title "$(L 'SELinux 상태' 'SELinux status')" \
        --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"
}

se_toggle_mode() {
    local cur choice
    cur="$(getenforce 2>/dev/null)"
    if [[ "$cur" == "Disabled" ]]; then
        msg "$(L '모드 전환' 'Switch mode')" "$(L 'SELinux 가 Disabled 상태입니다.\n활성화는 /etc/selinux/config 수정 + 재부팅이 필요합니다.' \
                                               'SELinux is Disabled.\nEnabling requires editing /etc/selinux/config and a reboot.')"
        return
    fi
    choice="$(dlg --title "$(L '동작 모드 전환 (일시적)' 'Switch mode (temporary)')" --menu \
        "$(L '현재 모드' 'Current mode'): $cur\n\n$(L '일시적으로 전환합니다. (재부팅 시 원복)\n영구 변경은 /etc/selinux/config 를 수정해야 합니다.' \
             'Temporary switch (reverts on reboot).\nFor a permanent change, edit /etc/selinux/config.')" \
        14 "$DLG_W" 2 \
        Enforcing  "$(L '정책 위반 차단 (권장)' 'Block violations (recommended)')" \
        Permissive "$(L '위반 기록만 — 문제 진단 시 임시 사용' 'Log only — temporary for troubleshooting')")" || return
    case "$choice" in
        Enforcing)  run_show "$(L 'Enforcing 전환' 'Switch to Enforcing')"  setenforce 1 ;;
        Permissive) run_show "$(L 'Permissive 전환' 'Switch to Permissive')" setenforce 0 ;;
    esac
}

