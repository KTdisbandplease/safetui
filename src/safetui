#!/usr/bin/env bash
#
# safetui - Firewall / SELinux / lockout guard / backup TUI
#
# RHEL / Rocky / AlmaLinux 9.
# Built on dialog. English / Korean UI (Language menu or SAFETUI_LANG=en|ko). English by default.
#
# Depends on: dialog, firewalld(firewall-cmd), policycoreutils,
#         policycoreutils-python-utils(semanage/audit2allow), setools-console
#
set -o pipefail

APP_NAME="safetui"
APP_VERSION="3.0.0"

# ---------------------------------------------------------------------------
# Language (i18n)
# ---------------------------------------------------------------------------
LANG_FILE="/etc/safetui/lang"
LANG_MODE="en"

# Optional defaults file shipped by a package. key=value format.
#   UI_LANG=ko|en            UI language on first run
#   DB_HOME / DB_DIR / ...   defaults for the backup settings (same keys as backup.conf)
# Values the user changed in the menu (/etc/safetui/) always win.
VENDOR_DEFAULTS="/usr/share/safetui/defaults.conf"
vendor_default() {  # $1=key -> value (empty if not set)
    [[ -r "$VENDOR_DEFAULTS" ]] || return 0
    local k v
    while IFS='=' read -r k v; do
        [[ "$k" == "$1" ]] && { printf '%s' "$v"; return 0; }
    done <"$VENDOR_DEFAULTS"
    return 0
}

# Priority: env SAFETUI_LANG > value chosen in the menu (/etc/safetui/lang) > package default > English
detect_lang() {
    local l="${SAFETUI_LANG:-}"
    [[ -z "$l" && -r "$LANG_FILE" ]] && l="$(cat "$LANG_FILE" 2>/dev/null)"
    [[ -z "$l" ]] && l="$(vendor_default UI_LANG)"
    case "$l" in ko|KO|korean) LANG_MODE="ko" ;; *) LANG_MODE="en" ;; esac
}
save_lang() {
    mkdir -p "$(dirname "$LANG_FILE")" 2>/dev/null
    printf '%s\n' "$LANG_MODE" > "$LANG_FILE" 2>/dev/null
    export SAFETUI_LANG="$LANG_MODE"   # child tools (safetui-guard) use the same language
}
# L "<korean>" "<english>"  - return the string for the current language
L() { if [[ "$LANG_MODE" == "en" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

detect_lang
export SAFETUI_LANG="$LANG_MODE"   # pass the language to child processes such as safetui-guard
BACKTITLE="safetui ${APP_VERSION} — $(L '방화벽·SELinux·작업 안전장치·백업' 'Firewall·SELinux·Guard·Backup')"

# default dialog window size
DLG_H=22
DLG_W=76
MENU_H=12

# color theme that shows the input field in reverse video (used if present)
for _rc in /usr/share/safetui/dialogrc "$(dirname "$0")/dialogrc"; do
    [[ -f "$_rc" ]] && { export DIALOGRC="$_rc"; break; }
done

# Temporary files
# root-only (700) temp directory - derived files (.avc etc.) are safe from /tmp symlink attacks
TMP_DIR="$(mktemp -d /tmp/safetui.XXXXXX)"
TMP_OUT="$TMP_DIR/out"
: >"$TMP_OUT"
EXIT_NOTE=""      # note to leave on the terminal after exit (only if set)
GOT_INT=0         # whether Ctrl+C was received
TICKER_PID=""     # background process that shows the guard countdown
cleanup() {
    [[ -n "$TICKER_PID" ]] && kill "$TICKER_PID" 2>/dev/null
    rm -rf "$TMP_DIR"
    [[ -t 1 ]] && clear 2>/dev/null
    [[ -n "$EXIT_NOTE" ]] && echo "$EXIT_NOTE" >&2
    return 0
}
# Clean up only once, at exit. (Cleaning up on Ctrl+C used to delete the temp directory while
# the program kept running, which broke the result screens.) Ctrl+C only means "back one level", like ESC.
trap cleanup EXIT
trap 'GOT_INT=1' INT
trap 'exit 143' TERM HUP

# Make dialog return ESC with a code different from a screen error (255), so the main menu can tell them apart
export DIALOG_ESC=27

# ---------------------------------------------------------------------------
# Common helpers
# ---------------------------------------------------------------------------
die() { echo "$(L '오류' 'Error'): $*" >&2; exit 1; }

need_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "$(L "이 도구는 root 권한이 필요합니다. 'sudo safetui' 로 실행하세요." \
                "This tool requires root. Run 'sudo safetui'.")" >&2
        exit 1
    fi
}

need_cmd() { command -v "$1" >/dev/null 2>&1; }

# Drop keys typed while the screen is changing, so they are not applied to a screen that is
# not visible yet (running the wrong item with Enter, or closing it with ESC)
flush_input() {
    local _k
    while read -r -s -n 1 -t 0.01 _k </dev/tty 2>/dev/null; do :; done
    return 0
}

# Wrapper that returns the dialog result on stdout. OK/Cancel/Back labels follow the language.
dlg() {
    flush_input
    dialog --backtitle "$BACKTITLE" \
        --ok-label "$(L '확인' 'OK')" --cancel-label "$(L '취소' 'Cancel')" "$@" 3>&1 1>&2 2>&3
}

# Free-text input. Uses whiptail (libnewt) so the arrow keys move between elements, like nmtui.
# Up/Down moves between the field, OK and Cancel; the active element is highlighted,
# Enter activates it. (dialog cannot move with the arrow keys, so only input boxes use whiptail)
dlg_input() {
    local title="$1" prompt="$2" def="${3:-}"
    local hint="$(L '[ ↑↓ 로 입력칸/확인/취소 이동, Enter 로 실행 ]' \
                    '[ Use up/down to move between field/OK/Cancel, Enter to activate ]')"
    # unlike dialog, whiptail does not interpret \n, so convert it to real line breaks
    local text="${prompt}"$'\n\n'"${hint}"
    text="${text//'\n'/$'\n'}"
    flush_input
    whiptail --title "$title" \
        --ok-button "$(L '확인' 'OK')" --cancel-button "$(L '취소' 'Cancel')" \
        --inputbox "$text" 13 "$DLG_W" "$def" \
        3>&1 1>&2 2>&3
}

# --cr-wrap: keep line breaks of command output / --no-collapse: keep alignment spaces
msg()  { flush_input; dialog --backtitle "$BACKTITLE" --ok-label "$(L '확인' 'OK')" --title "$1" --cr-wrap --no-collapse --msgbox "$2" "${3:-$DLG_H}" "${4:-$DLG_W}"; }
yesno(){ flush_input; dialog --backtitle "$BACKTITLE" --yes-label "$(L '예' 'Yes')" --no-label "$(L '아니오' 'No')" --title "$1" --yesno "$2" "${3:-10}" "${4:-$DLG_W}"; }

# Run a command and show success / failure in a dialog.
run_show() {
    local title="$1"; shift
    if "$@" >"$TMP_OUT" 2>&1; then
        msg "$title — $(L '성공' 'OK')" "$(L '명령이 정상 실행되었습니다.' 'Command completed successfully.')\n\n\$ $*\n\n$(cat "$TMP_OUT")"
        return 0
    else
        msg "$title — $(L '실패' 'Failed')" "$(L '명령 실행에 실패했습니다.' 'Command failed.')\n\n\$ $*\n\n$(cat "$TMP_OUT")"
        return 1
    fi
}

# Show long output in a scrolling window. Long lines are wrapped to the window width
# (fold -s: break at word boundaries, so you only scroll up and down, never sideways)
show_text() {
    local title="$1"; shift
    "$@" 2>&1 | fold -s -w "$((DLG_W-6))" >"$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" --title "$title" \
        --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"
}

# ---------------------------------------------------------------------------
# Guard countdown - right side of the top line (22 columns)
#   While armed, "Rollback in 04:32" is refreshed every second. Red background for the last 60 seconds.
#   After a rollback, "Rolled back HH:MM:SS" is shown on green for 10 minutes.
#   The cursor is saved / restored (ESC 7 / ESC 8) and only that spot is overwritten, so the menu is untouched.
# ---------------------------------------------------------------------------
GUARD_ACTIVE="/var/lib/safetui-guard/active"
GUARD_TXT=""; GUARD_COLOR=""
guard_ticker_text() {
    local now at to left rb
    GUARD_TXT=""; GUARD_COLOR='1;33;44'
    [[ -f "$GUARD_ACTIVE/armed_at" && -f "$GUARD_ACTIVE/timeout" && ! -f "$GUARD_ACTIVE/confirmed" ]] || return 0
    printf -v now '%(%s)T' -1
    if [[ -f "$GUARD_ACTIVE/rolled_back" ]]; then
        rb="$(<"$GUARD_ACTIVE/rolled_back")"
        if [[ "$rb" =~ ^[0-9]+$ ]] && (( now - rb < 600 )); then
            printf -v GUARD_TXT ' %s %(%H:%M:%S)T ' "$(L '원복 완료' 'Rolled back')" "$rb"; GUARD_COLOR='1;37;42'
        fi
        return 0
    fi
    at="$(<"$GUARD_ACTIVE/armed_at")"; to="$(<"$GUARD_ACTIVE/timeout")"
    [[ "$at" =~ ^[0-9]+$ && "$to" =~ ^[0-9]+$ ]] || return 0
    left=$(( at + to - now ))
    if (( left > 0 )); then
        printf -v GUARD_TXT ' %s %02d:%02d ' "$(L '자동 원복까지' 'Rollback in')" $(( left / 60 )) $(( left % 60 ))
        (( left <= 60 )) && GUARD_COLOR='1;37;41'
    elif (( left > -120 )); then
        GUARD_TXT=" $(L '자동 원복 중...' 'Rolling back...') "; GUARD_COLOR='1;37;41'
    fi
    return 0
}
guard_ticker() {
    local last="" cols w pad col
    trap '' INT
    while kill -0 $$ 2>/dev/null; do
        guard_ticker_text
        if [[ -n "$GUARD_TXT" || -n "$last" ]]; then
            cols="$(stty size </dev/tty 2>/dev/null)"; cols="${cols##* }"
            [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
            w="${GUARD_TXT//[[:ascii:]]/}"; w=$(( ${#GUARD_TXT} + ${#w} ))   # Hangul takes 2 columns
            pad=$(( 22 - w )); (( pad < 0 )) && pad=0
            col=$(( cols - 21 )); (( col < 1 )) && col=1
            printf '\0337\033[1;%dH\033[0;44m%*s\033[%sm%s\0338' "$col" "$pad" '' "$GUARD_COLOR" "$GUARD_TXT" >/dev/tty 2>/dev/null
        fi
        last="$GUARD_TXT"
        sleep 1
    done
}

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------
preflight() {
    need_cmd dialog || die "$(L "'dialog' 가 설치되어 있지 않습니다. (dnf install dialog)" \
                              "'dialog' is not installed. (dnf install dialog)")"
    local missing=()
    need_cmd firewall-cmd || missing+=("firewalld")
    need_cmd getenforce   || missing+=("libselinux-utils")
    need_cmd semanage     || missing+=("policycoreutils-python-utils")
    if [[ ${#missing[@]} -gt 0 ]]; then
        msg "$(L '구성요소 확인' 'Component check')" \
            "$(L '다음 패키지가 없어 일부 기능이 제한될 수 있습니다:' 'Some features may be limited; missing packages:')\n\n  ${missing[*]}\n\n$(L '설치' 'Install'):\n  dnf install ${missing[*]}"
    fi
}

# ---------------------------------------------------------------------------
# Firewall (firewalld)
# ---------------------------------------------------------------------------
fw_default_zone() { firewall-cmd --get-default-zone 2>/dev/null; }
fw_running() { firewall-cmd --state >/dev/null 2>&1; }

fw_pick_zone() {
    local zones dz z
    dz="$(fw_default_zone)"
    zones="$(firewall-cmd --get-zones 2>/dev/null)"
    # public (the usual default zone) first, the rest after it
    local ordered
    ordered="$(printf '%s\n' $zones | grep -x public; printf '%s\n' $zones | grep -vx public)"
    local args=()
    for z in $ordered; do
        if [[ "$z" == "$dz" ]]; then
            args+=("$z" "$(L '기본 존 (default)' 'default zone')")
        else
            args+=("$z" " ")
        fi
    done
    dlg --title "$(L '존(zone) 선택' 'Select zone')" --default-item "$dz" \
        --menu "$(L '정책을 적용할 방화벽 존을 선택하세요.\n(잘 모르면 기본 존을 그대로 선택)' \
                   'Select the firewall zone to apply to.\n(If unsure, keep the default zone)')" \
        18 "$DLG_W" "$MENU_H" "${args[@]}"
}

fw_overview() {
    {
        echo "===================================================================="
        echo " $(L '방화벽(firewalld) 현재 상태 요약' 'firewalld — current status summary')"
        echo "===================================================================="
        echo
        echo "[ $(L '서비스 상태' 'Service state') ]"
        firewall-cmd --state 2>&1
        echo
        echo "[ $(L '기본 존' 'Default zone') ]  $(fw_default_zone)"
        echo "[ $(L '활성 존' 'Active zones') ]"
        firewall-cmd --get-active-zones 2>&1
        echo
        echo "===================================================================="
        echo " $(L '각 존별 상세 정책 (public 우선)' 'Per-zone details (public first)')"
        echo "===================================================================="
        local _zl z
        _zl="$(firewall-cmd --get-zones 2>/dev/null)"
        for z in $(printf '%s\n' $_zl | grep -x public; printf '%s\n' $_zl | grep -vx public); do
            echo "──────────────── zone: $z ────────────────"
            firewall-cmd --zone="$z" --list-all 2>&1
            echo
        done
    } | fold -s -w "$((DLG_W-6))" >"$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" \
        --title "$(L '방화벽 정책 한눈에 보기' 'Firewall policy overview')" \
        --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"
}

# --- input validation ---
valid_port()   { [[ "$1" =~ ^[0-9]{1,5}(-[0-9]{1,5})?$ ]]; }
valid_ipcidr() { [[ "$1" =~ ^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$ ]]; }

# --- warning before a change that can cut the remote session ---
guard_armed() { systemctl is-active --quiet safetui-guard.timer 2>/dev/null; }

# ports SSH listens on (from the sshd configuration, there can be several)
remote_access_ports() {
    local p
    p="$(sshd -T 2>/dev/null | awk '/^port /{print $2}')"
    echo "${p:-22}"
}

# returns 0 if a port string (e.g. 22/tcp, 20-30/tcp) includes a remote access port
port_hits_remote() {
    local spec="${1%%/*}" lo hi rp
    lo="${spec%%-*}"; hi="${spec##*-}"
    for rp in $(remote_access_ports); do
        [[ "$rp" =~ ^[0-9]+$ ]] || continue
        (( rp >= lo && rp <= hi )) && return 0
    done
    return 1
}

# lockout_check "<what is about to be done>"
#   If the guard is off: choose [arm the guard and continue / just continue / cancel].
#   Returns 0 to continue, 1 to cancel.
lockout_check() {
    local what="$1" sel
    guard_armed && return 0
    need_cmd safetui-guard || return 0
    sel="$(dlg --title "$(L '[주의] 원격 접속이 끊길 수 있는 작업' '[CAUTION] This may cut remote access')" \
        --cancel-label "$(L '취소' 'Cancel')" --menu \
        "$(L "지금 하려는 작업:" "About to:") $what\n\n$(L "잘못되면 SSH 접속이 끊겨 서버에 다시 못 들어올 수 있습니다.\n작업 안전장치를 켜두면, 5분 안에 '확정'하지 않을 경우\n방화벽이 자동으로 원래대로 돌아옵니다." \
             "If this goes wrong you may lose SSH access to the server.\nWith the lockout guard armed, the firewall reverts\nautomatically unless you confirm within 5 minutes.")" \
        15 "$DLG_W" 2 \
        arm  "$(L '안전장치 켜고 진행 (권장)' 'Arm the guard, then proceed (recommended)')" \
        skip "$(L '안전장치 없이 그냥 진행' 'Proceed without the guard')")" || return 1
    if [[ "$sel" == "arm" ]]; then
        if safetui-guard arm --timeout 300 --targets firewall --note "safetui: $what" >"$TMP_OUT" 2>&1; then
            msg "$(L '안전장치 켜짐' 'Guard armed')" \
                "$(L "안전장치가 켜졌습니다 (5분).\n\n작업 후 새 SSH 창으로 접속이 되는지 확인하고,\n메인 메뉴 → 작업 안전장치 → '확정(ok)' 을 누르세요.\n확정하지 않으면 5분 뒤 자동으로 원래대로 돌아갑니다." \
                     "The guard is armed (5 minutes).\n\nAfter the change, open a NEW SSH window to check access, then\nMain menu → Lockout guard → 'Confirm (ok)'.\nIf not confirmed, it reverts automatically after 5 minutes.")" 14
        else
            msg "$(L '안전장치 켜기 실패' 'Guard arm failed')" "$(L '안전장치를 켜지 못해 작업을 중단합니다.' 'Could not arm the guard; aborting.')\n\n$(cat "$TMP_OUT")"
            return 1
        fi
    fi
    return 0
}

fw_add_port() {
    local zone port proto
    zone="$(fw_pick_zone)" || return
    port="$(dlg_input "$(L '포트 추가' 'Add port')" \
        "$(L '열고 싶은 포트 번호를 입력하세요.\n예) 8080  또는  8000-8100 (범위)' \
             'Enter the port to open.\ne.g. 8080  or  8000-8100 (range)')")" || return
    [[ -z "$port" ]] && { msg "$(L '포트 추가' 'Add port')" "$(L '포트 번호가 비어 있습니다.' 'Port is empty.')"; return; }
    valid_port "$port" || { msg "$(L '포트 추가' 'Add port')" "$(L "'$port' 는 올바른 포트가 아닙니다.\n숫자(예: 8080) 또는 범위(예: 8000-8100)로 입력하세요." "'$port' is not a valid port.\nUse a number (e.g. 8080) or a range (e.g. 8000-8100).")" 10; return; }

    proto="$(dlg --title "$(L '프로토콜 선택' 'Select protocol')" --menu "$(L '프로토콜을 선택하세요.' 'Select a protocol.')" 11 "$DLG_W" 3 \
        tcp "$(L '일반적인 웹/앱 (대부분 tcp)' 'Common web/app (usually tcp)')" \
        udp "$(L 'DNS, VPN 등' 'DNS, VPN, etc.')" )" || return

    if yesno "$(L '확인' 'Confirm')" "$(L '다음 정책을 [영구]로 추가합니다.' 'Add the following rule [permanent].')\n\n  $(L '존' 'zone'): $zone\n  $(L '포트' 'port'): ${port}/${proto}\n\n$(L '진행할까요?' 'Proceed?')"; then
        if firewall-cmd --zone="$zone" --add-port="${port}/${proto}" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '포트 추가 — 성공' 'Add port — OK')" "$(L "${port}/${proto} 포트를 '$zone' 존에서 모두에게 열었습니다.\n재부팅 후에도 유지됩니다." "Opened ${port}/${proto} to everyone in zone '$zone'.\nIt persists across reboots.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '포트 추가 — 실패' 'Add port — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

fw_del_port() {
    local zone port ports args=()
    zone="$(fw_pick_zone)" || return
    ports="$(firewall-cmd --zone="$zone" --list-ports 2>/dev/null)"
    if [[ -z "$ports" ]]; then
        msg "$(L '포트 삭제' 'Remove port')" "$(L '이 존에 등록된 포트가 없습니다.' 'No ports registered in this zone.') ($zone)"
        return
    fi
    for p in $ports; do args+=("$p" " "); done
    port="$(dlg --title "$(L '포트 삭제' 'Remove port')" --menu "$(L '삭제할 포트를 선택하세요.' 'Select a port to remove.') ($zone)" \
        18 "$DLG_W" "$MENU_H" "${args[@]}")" || return

    if port_hits_remote "$port"; then
        lockout_check "$(L "포트 $port 삭제 ($zone 존) — 원격 접속(SSH) 포트입니다" "remove port $port ($zone) — this is a remote-access (SSH) port")" || return
    fi
    if yesno "$(L '확인' 'Confirm')" "$(L '다음 포트 정책을 삭제합니다.' 'Remove the following port rule.')\n\n  $(L '존' 'zone'): $zone\n  $(L '포트' 'port'): $port\n\n$(L '진행할까요?' 'Proceed?')"; then
        if firewall-cmd --zone="$zone" --remove-port="$port" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '포트 삭제 — 성공' 'Remove port — OK')" "$(L "'$zone' 존에서 $port 포트를 닫았습니다." "Closed $port in zone '$zone'.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '포트 삭제 — 실패' 'Remove port — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

fw_add_source() {
    local zone ip
    zone="$(fw_pick_zone)" || return
    ip="$(dlg_input "$(L '출발지 IP를 존에 등록' 'Assign source IP to zone')" \
        "$(L "이 IP/대역에서 오는 접속에 '$zone' 존의 규칙을 적용합니다.\n예) 192.168.0.10  또는  192.168.0.0/24\n\n※ '특정 IP만 어떤 포트에 접속 허용'이 목적이면\n   '특정 IP에서만 포트 허용' 메뉴를 쓰세요." \
             "Traffic from this IP/CIDR will use the '$zone' zone rules.\ne.g. 192.168.0.10  or  192.168.0.0/24\n\n* To allow ONLY a specific IP to reach a port,\n  use 'Allow a port only from a specific IP'.")")" || return
    [[ -z "$ip" ]] && { msg "$(L '출발지 IP 등록' 'Assign source IP')" "$(L 'IP가 비어 있습니다.' 'IP is empty.')"; return; }
    valid_ipcidr "$ip" || { msg "$(L '출발지 IP 등록' 'Assign source IP')" "$(L "'$ip' 는 올바른 IP/대역이 아닙니다." "'$ip' is not a valid IP/CIDR.")" 8; return; }

    if yesno "$(L '확인' 'Confirm')" "$(L '다음 출발지(source)를 존에 [영구]로 허용합니다.' 'Allow the following source [permanent].')\n\n  $(L '존' 'zone'): $zone\n  IP: $ip\n\n$(L '진행할까요?' 'Proceed?')"; then
        if firewall-cmd --zone="$zone" --add-source="$ip" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '출발지 IP 등록 — 성공' 'Assign source IP — OK')" "$(L "$ip 에서 오는 접속에 이제 '$zone' 존 규칙이 적용됩니다." "Traffic from $ip now uses the '$zone' zone rules.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '출발지 IP 등록 — 실패' 'Assign source IP — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

fw_del_source() {
    local zone ip sources args=()
    zone="$(fw_pick_zone)" || return
    sources="$(firewall-cmd --zone="$zone" --list-sources 2>/dev/null)"
    if [[ -z "$sources" ]]; then
        msg "$(L '출발지 IP 등록 삭제' 'Remove source IP')" "$(L '이 존에 등록된 출발지 IP가 없습니다.' 'No source IPs in this zone.') ($zone)"
        return
    fi
    for s in $sources; do args+=("$s" " "); done
    ip="$(dlg --title "$(L '출발지 IP 등록 삭제' 'Remove source IP')" --menu "$(L '삭제할 출발지 IP를 선택하세요.' 'Select a source IP to remove.') ($zone)" \
        18 "$DLG_W" "$MENU_H" "${args[@]}")" || return

    lockout_check "$(L "출발지 IP $ip 삭제 ($zone 존) — 이 IP 로 접속 중이라면 끊길 수 있습니다" "remove source $ip ($zone) — you may be cut off if you connect from it")" || return
    if yesno "$(L '확인' 'Confirm')" "$(L '다음 출발지를 존에서 삭제합니다.' 'Remove this source from the zone.')\n  $ip ($zone)\n\n$(L '진행할까요?' 'Proceed?')"; then
        if firewall-cmd --zone="$zone" --remove-source="$ip" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '출발지 IP 등록 삭제 — 성공' 'Remove source IP — OK')" "$(L "$ip 를 '$zone' 존에서 뺐습니다." "Removed $ip from zone '$zone'.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '출발지 IP 등록 삭제 — 실패' 'Remove source IP — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

# rich rule as a readable sentence (the raw rule if the format is different)
rich_human() {
    if [[ "$LANG_MODE" == "en" ]]; then
        sed -E 's/^rule family="ipv[46]" source address="([^"]+)" port port="([^"]+)" protocol="([^"]+)" accept$/allow \2\/\3 only from \1/'
    else
        sed -E 's/^rule family="ipv[46]" source address="([^"]+)" port port="([^"]+)" protocol="([^"]+)" accept$/\1 에서만 \2\/\3 접속 허용/'
    fi
}

# allow a port from one IP only (firewalld rich rule)
fw_add_ip_port_rule() {
    local zone ip port proto fam rule
    zone="$(fw_pick_zone)" || return
    ip="$(dlg_input "$(L '특정 IP에서만 포트 허용 (1/3)' 'Allow a port only from a specific IP (1/3)')" \
        "$(L '접속을 허용할 출발지 IP 또는 대역을 입력하세요.\n예) 192.168.0.10  또는  192.168.0.0/24' \
             'Enter the source IP or CIDR to allow.\ne.g. 192.168.0.10  or  192.168.0.0/24')")" || return
    [[ -z "$ip" ]] && return
    valid_ipcidr "$ip" || { msg "$(L '특정 IP에서만 포트 허용' 'Allow port from IP')" "$(L "'$ip' 는 올바른 IP/대역이 아닙니다." "'$ip' is not a valid IP/CIDR.")" 8; return; }
    port="$(dlg_input "$(L '특정 IP에서만 포트 허용 (2/3)' 'Allow a port only from a specific IP (2/3)')" \
        "$(L "$ip 에게 열어줄 포트 번호를 입력하세요.\n예) 3306  또는  8000-8100" \
             "Port to open for $ip.\ne.g. 3306  or  8000-8100")")" || return
    [[ -z "$port" ]] && return
    valid_port "$port" || { msg "$(L '특정 IP에서만 포트 허용' 'Allow port from IP')" "$(L "'$port' 는 올바른 포트가 아닙니다." "'$port' is not a valid port.")" 8; return; }
    proto="$(dlg --title "$(L '특정 IP에서만 포트 허용 (3/3)' 'Allow a port only from a specific IP (3/3)')" \
        --menu "$(L '프로토콜을 선택하세요.' 'Select a protocol.')" 11 "$DLG_W" 2 \
        tcp "$(L '일반적인 웹/앱/DB (대부분 tcp)' 'Common web/app/DB (usually tcp)')" \
        udp "$(L 'DNS, VPN 등' 'DNS, VPN, etc.')")" || return
    fam="ipv4"; [[ "$ip" == *:* ]] && fam="ipv6"
    rule="rule family=\"$fam\" source address=\"$ip\" port port=\"$port\" protocol=\"$proto\" accept"

    yesno "$(L '확인' 'Confirm')" "$(L '다음 규칙을 [영구]로 추가합니다.' 'Add the following rule [permanent].')\n\n  $(L '존' 'zone'): $zone\n  $(L '허용 IP' 'from'): $ip\n  $(L '포트' 'port'): ${port}/${proto}\n\n$(L "※ 이 포트가 '포트 추가'로 모두에게 열려 있다면\n   이 규칙과 상관없이 모두 접속 가능합니다." "* If this port is also opened to everyone via 'Add port',\n  everyone can still connect regardless of this rule.")\n\n$(L '진행할까요?' 'Proceed?')" 16 || return
    if firewall-cmd --zone="$zone" --add-rich-rule="$rule" --permanent >"$TMP_OUT" 2>&1; then
        firewall-cmd --reload >>"$TMP_OUT" 2>&1
        msg "$(L '특정 IP 허용 — 성공' 'Allow from IP — OK')" "$(L "이제 $ip 에서만 ${port}/${proto} 포트로 접속할 수 있습니다. ('$zone' 존)\n재부팅 후에도 유지됩니다." "Now only $ip can connect to ${port}/${proto} (zone '$zone').\nIt persists across reboots.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
    else
        msg "$(L '특정 IP 허용 — 실패' 'Allow from IP — Failed')" "$(cat "$TMP_OUT")"
    fi
}

fw_del_ip_port_rule() {
    local zone rules args=() i=0 r idx rule
    zone="$(fw_pick_zone)" || return
    mapfile -t rules < <(firewall-cmd --zone="$zone" --list-rich-rules 2>/dev/null)
    if [[ ${#rules[@]} -eq 0 ]]; then
        msg "$(L '특정 IP 허용 규칙 삭제' 'Remove IP rule')" "$(L '이 존에 등록된 규칙이 없습니다.' 'No rules in this zone.') ($zone)" 8
        return
    fi
    for r in "${rules[@]}"; do args+=("$i" "$(rich_human <<<"$r")"); ((i++)); done
    idx="$(dlg --title "$(L '특정 IP 허용 규칙 삭제' 'Remove IP rule')" \
        --menu "$(L '삭제할 규칙을 선택하세요.' 'Select a rule to remove.') ($zone)" \
        "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return
    rule="${rules[$idx]}"
    local rport
    rport="$(sed -n 's/.*port port="\([0-9-]*\)".*/\1/p' <<<"$rule")"
    if [[ -n "$rport" ]] && port_hits_remote "$rport"; then
        lockout_check "$(L "원격 접속 포트($rport) 규칙 삭제" "remove a rule for the remote-access port ($rport)")" || return
    elif [[ "$rule" == *'service name="ssh"'* ]]; then
        lockout_check "$(L "ssh 서비스 규칙 삭제" "remove an ssh service rule")" || return
    fi
    yesno "$(L '확인' 'Confirm')" "$(L '다음 규칙을 삭제합니다.' 'Remove this rule.')\n\n  $rule\n\n$(L '진행할까요?' 'Proceed?')" 12 || return
    if firewall-cmd --zone="$zone" --remove-rich-rule="$rule" --permanent >"$TMP_OUT" 2>&1; then
        firewall-cmd --reload >>"$TMP_OUT" 2>&1
        msg "$(L '규칙 삭제 — 성공' 'Remove rule — OK')" "$(L "규칙을 삭제했습니다:" "Removed rule:") $(rich_human <<<"$rule")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
    else
        msg "$(L '규칙 삭제 — 실패' 'Remove rule — Failed')" "$(cat "$TMP_OUT")"
    fi
}

fw_service_manage() {
    local zone action svc svcs args=()
    zone="$(fw_pick_zone)" || return
    action="$(dlg --title "$(L '서비스 관리' 'Service management')" --menu "$(L '무엇을 할까요?' 'What to do?') ($zone)" 12 "$DLG_W" 2 \
        add "$(L '서비스 추가 (예: http, https, mysql)' 'Add service (e.g. http, https, mysql)')" \
        del "$(L '등록된 서비스 삭제' 'Remove a registered service')" )" || return

    if [[ "$action" == "add" ]]; then
        svcs="$(firewall-cmd --get-services 2>/dev/null | tr ' ' '\n' | sort)"
        for s in $svcs; do args+=("$s" " "); done
        svc="$(dlg --title "$(L '서비스 추가' 'Add service')" --menu "$(L '추가할 서비스를 선택하세요.' 'Select a service to add.')" \
            "$DLG_H" "$DLG_W" "$MENU_H" "${args[@]}")" || return
        if firewall-cmd --zone="$zone" --add-service="$svc" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '서비스 추가 — 성공' 'Add service — OK')" "$(L "'$svc' 서비스를 '$zone' 존에서 모두에게 열었습니다." "Opened service '$svc' to everyone in zone '$zone'.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '서비스 추가 — 실패' 'Add service — Failed')" "$(cat "$TMP_OUT")"
        fi
    else
        svcs="$(firewall-cmd --zone="$zone" --list-services 2>/dev/null)"
        [[ -z "$svcs" ]] && { msg "$(L '서비스 삭제' 'Remove service')" "$(L '등록된 서비스가 없습니다.' 'No services registered.')"; return; }
        for s in $svcs; do args+=("$s" " "); done
        svc="$(dlg --title "$(L '서비스 삭제' 'Remove service')" --menu "$(L '삭제할 서비스를 선택하세요.' 'Select a service to remove.')" \
            18 "$DLG_W" "$MENU_H" "${args[@]}")" || return
        if [[ "$svc" == "ssh" ]]; then
            lockout_check "$(L "ssh 서비스 삭제 ($zone 존) — 새 SSH 접속이 막힙니다" "remove the ssh service ($zone) — new SSH logins will be blocked")" || return
        fi
        yesno "$(L '확인' 'Confirm')" "$(L '다음 서비스를 존에서 삭제합니다.' 'Remove this service from the zone.')\n\n  $svc ($zone)\n\n$(L '진행할까요?' 'Proceed?')" || return
        if firewall-cmd --zone="$zone" --remove-service="$svc" --permanent >"$TMP_OUT" 2>&1; then
            firewall-cmd --reload >>"$TMP_OUT" 2>&1
            msg "$(L '서비스 삭제 — 성공' 'Remove service — OK')" "$(L "'$zone' 존에서 '$svc' 서비스를 닫았습니다." "Closed service '$svc' in zone '$zone'.")\n\n$(L '명령 결과' 'Command output'):\n$(cat "$TMP_OUT")" 14
        else
            msg "$(L '서비스 삭제 — 실패' 'Remove service — Failed')" "$(cat "$TMP_OUT")"
        fi
    fi
}

fw_reload() {
    run_show "$(L '방화벽 다시 적용(reload)' 'Reload firewall')" firewall-cmd --reload
}

# extract only the active zone names (lines that are not indented)
fw_active_zones() { firewall-cmd --get-active-zones 2>/dev/null | grep -v '^[[:space:]]'; }

# short view: open ports only
fw_view_ports() {
    {
        echo "$(L '현재 열린 포트 / 서비스 (활성 존)' 'Open ports / services (active zones)')"
        echo "===================================================================="
        local z
        for z in $(fw_active_zones); do
            echo
            echo "[ zone: $z ]"
            echo "  $(L '포트(모두에게 열림)' 'ports (open to all)')  : $(firewall-cmd --zone="$z" --list-ports 2>/dev/null)"
            echo "  $(L '서비스(모두에게 열림)' 'services (open to all)'): $(firewall-cmd --zone="$z" --list-services 2>/dev/null)"
            local rr
            rr="$(firewall-cmd --zone="$z" --list-rich-rules 2>/dev/null)"
            if [[ -n "$rr" ]]; then
                echo "  $(L '특정 IP 전용 규칙' 'IP-specific rules'):"
                rich_human <<<"$rr" | sed 's/^/    - /'
            fi
        done
    } | fold -s -w "$((DLG_W-6))" >"$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" \
        --title "$(L '현재 포트 보기' 'Current ports')" --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"
}

# short view: allowed source IPs only
fw_view_sources() {
    {
        echo "$(L '현재 허용된 출발지 IP (활성 존)' 'Allowed source IPs (active zones)')"
        echo "===================================================================="
        local z s
        for z in $(fw_active_zones); do
            s="$(firewall-cmd --zone="$z" --list-sources 2>/dev/null)"
            echo
            echo "[ zone: $z ]"
            echo "  $(L '존에 등록된 IP/대역' 'zone sources'): ${s:-$(L '(없음)' '(none)')}"
            local ri
            ri="$(firewall-cmd --zone="$z" --list-rich-rules 2>/dev/null | sed -n 's/.*source address="\([^"]*\)".*port port="\([^"]*\)" protocol="\([^"]*\)".*/\1 → \2\/\3/p')"
            if [[ -n "$ri" ]]; then
                echo "  $(L '특정 포트만 허용된 IP' 'IPs allowed to specific ports'):"
                sed 's/^/    - /' <<<"$ri"
            fi
        done
    } | fold -s -w "$((DLG_W-6))" >"$TMP_OUT"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" \
        --title "$(L '현재 IP 보기' 'Current source IPs')" --textbox "$TMP_OUT" "$DLG_H" "$DLG_W"
}

firewall_menu() {
    if ! need_cmd firewall-cmd; then
        msg "$(L '방화벽' 'Firewall')" "$(L 'firewalld 가 설치되어 있지 않습니다.' 'firewalld is not installed.')\n\n  dnf install firewalld\n  systemctl enable --now firewalld"
        return
    fi
    if ! fw_running; then
        if yesno "$(L '방화벽 꺼짐' 'Firewall off')" "$(L 'firewalld 서비스가 실행 중이 아닙니다.\n지금 시작할까요? (systemctl start firewalld)' \
                                                        'firewalld is not running.\nStart it now? (systemctl start firewalld)')"; then
            systemctl start firewalld >"$TMP_OUT" 2>&1 || msg "$(L '시작 실패' 'Start failed')" "$(cat "$TMP_OUT")"
        fi
    fi

    while true; do
        local choice
        choice="$(dlg --title "$(L '방화벽 관리 (firewalld)' 'Firewall (firewalld)')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '원하는 작업을 선택하세요.' 'Choose an action.')\n$(L '기본 존' 'Default zone'): $(fw_default_zone)" \
            "$DLG_H" "$DLG_W" "$MENU_H" \
            1  "$(L '현재 포트 보기' 'View current ports')" \
            2  "$(L '현재 IP 보기 (출발지)' 'View current source IPs')" \
            3  "$(L '현재 정책 한눈에 보기 (전체)' 'Full policy overview')" \
            4  "$(L '포트 추가 (모두에게 열기)' 'Add port (open to everyone)')" \
            5  "$(L '포트 삭제' 'Remove port')" \
            6  "$(L '특정 IP에서만 포트 허용' 'Allow a port only from a specific IP')" \
            7  "$(L '특정 IP 허용 규칙 삭제' 'Remove an IP-specific rule')" \
            8  "$(L '출발지 IP를 존에 등록' 'Assign source IP to zone')" \
            9  "$(L '출발지 IP 등록 삭제' 'Remove source IP from zone')" \
            10 "$(L '서비스 추가 / 삭제' 'Add / remove service')" \
            11 "$(L '방화벽 다시 적용 (reload)' 'Reload firewall')")" || return
        case "$choice" in
            1)  fw_view_ports ;;
            2)  fw_view_sources ;;
            3)  fw_overview ;;
            4)  fw_add_port ;;
            5)  fw_del_port ;;
            6)  fw_add_ip_port_rule ;;
            7)  fw_del_ip_port_rule ;;
            8)  fw_add_source ;;
            9)  fw_del_source ;;
            10) fw_service_manage ;;
            11) fw_reload ;;
        esac
    done
}

