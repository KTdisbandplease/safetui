# ---------------------------------------------------------------------------
# Lockout guard (wraps safetui-guard)
# ---------------------------------------------------------------------------
guard_menu() {
    if ! need_cmd safetui-guard; then
        msg "$(L '안전장치(가드)' 'Lockout guard')" "$(L 'safetui-guard 가 설치되어 있지 않습니다.' 'safetui-guard is not installed.')"
        return
    fi
    while true; do
        local status_line choice
        status_line="$(safetui-guard status 2>/dev/null | head -1)"
        choice="$(dlg --title "$(L '작업 안전장치 (원격 락아웃 방지)' 'Lockout guard')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '방화벽/네트워크/sshd 를 위험하게 바꾸기 전에 켜두면,\n확정 안 할 시 자동으로 원상복구됩니다.' \
                       'Arm before risky firewall/network/sshd changes;\nif not confirmed, it auto-reverts.')\n\n$(L '현재' 'Now'): ${status_line}" \
            "$DLG_H" "$DLG_W" "$MENU_H" \
            1 "$(L '안전장치 켜기 (arm) — 스냅샷 + 자동 롤백 예약' 'Arm — snapshot + schedule auto-rollback')" \
            2 "$(L '확정 (ok) — 접속 정상, 자동 롤백 취소' 'Confirm (ok) — cancel auto-rollback')" \
            3 "$(L '상태 보기' 'View status')" \
            4 "$(L '지금 즉시 롤백' 'Roll back now')" \
            5 "$(L '기록 보기 (켬·확정·원복 이력)' 'View history (arm / confirm / rollback)')")" || return
        case "$choice" in
            1)
                local t note tsel targets
                tsel="$(dlg --title "$(L '가드 대상 선택' 'Select guard targets')" --checklist \
                    "$(L '스냅샷 + 자동복구할 대상을 고르세요. (스페이스로 선택)' 'Choose targets to snapshot + auto-restore. (Space to select)')" \
                    14 "$DLG_W" 3 \
                    firewall "$(L '방화벽(firewalld) 규칙' 'Firewall (firewalld) rules')" on \
                    sshd     "$(L 'SSH 서버 설정(sshd_config)' 'SSH server config (sshd_config)')" off \
                    network  "$(L '네트워크(NetworkManager) 연결' 'Network (NetworkManager) connections')" off)" || continue
                targets="$(echo "$tsel" | tr -d '"' | tr ' ' ',')"
                [[ -z "$targets" ]] && { msg "$(L '안전장치' 'Guard')" "$(L '대상을 하나 이상 선택하세요.' 'Select at least one target.')"; continue; }
                t="$(dlg_input "$(L '안전장치 켜기' 'Arm guard')" \
                    "$(L "자동 롤백까지의 시간(초)을 입력하세요. (30 ~ 3600)\n이 시간 안에 '확정'하지 않으면 자동 원복됩니다.\n예) 300 = 5분" \
                         "Seconds until auto-rollback. (30 - 3600)\nIf not confirmed within this time, it auto-reverts.\ne.g. 300 = 5 minutes")" "300")" || continue
                if ! [[ "$t" =~ ^[0-9]+$ ]] || (( t < 30 || t > 3600 )); then
                    msg "$(L '안전장치 켜기' 'Arm guard')" "$(L "'$t' 는 사용할 수 없는 값입니다.\n30 ~ 3600 사이의 숫자(초)로 입력하세요." "'$t' is not allowed.\nEnter a number of seconds between 30 and 3600.")" 9
                    continue
                fi
                note="$(dlg_input "$(L '메모(선택)' 'Note (optional)')" "$(L '무슨 작업인지 메모 (선택)' 'What are you doing? (optional)')")" || note=""
                run_show "$(L '안전장치 켜기' 'Arm guard')" safetui-guard arm --timeout "$t" --targets "$targets" --note "$note"
                ;;
            2) run_show "$(L '확정(ok)' 'Confirm (ok)')" safetui-guard ok ;;
            3) show_text "$(L '가드 상태' 'Guard status')" safetui-guard status ;;
            4) if yesno "$(L '즉시 롤백' 'Roll back now')" "$(L '지금 즉시 스냅샷 상태로 되돌립니다.\n진행할까요?' 'Revert to the snapshot state now.\nProceed?')"; then
                   run_show "$(L '즉시 롤백' 'Roll back now')" safetui-guard rollback
               fi ;;
            5) show_text "$(L '작업 안전장치 기록' 'Guard history')" safetui-guard log ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Backup - files and folders / MariaDB
# ---------------------------------------------------------------------------
BK_CONF="/etc/safetui/backup.conf"
BK_HIST="/var/log/safetui-backup.log"   # file backup history (time<TAB>source<TAB>backup)

# Default settings (bk_load overrides them when backup.conf exists)
BK_DB_HOME="/usr"                         # MariaDB install path (bin/mariadb-dump under it is used)
BK_DB_USER="root"
BK_DB_PASS=""                             # empty = connect without a password
BK_DB_NAME=""                             # empty = all databases
BK_DB_DIR="/tmp/backup/db"                # where DB dumps are stored
BK_DB_KEEP_DAYS="30"                      # 0 = never delete
BK_DEST_MODE="same"                       # same = next to the original, dir = BK_DEST_DIR
BK_DEST_DIR="/tmp/backup/files"
BK_SUFFIX='_$today'                       # $today → YYYYMMDD, $time → HHMMSS
BK_EXISTS="ask"                           # ask | number | overwrite | skip
BK_DB_COMPRESS="yes"                      # yes = .sql.gz, no = .sql
BK_TAR="no"                               # yes = bundle several selected items into one tar file
BK_SCHED="off"                            # scheduled DB backup: off | daily | weekly | monthly
BK_SCHED_DOW="Mon"                        # weekday for weekly (Mon..Sun)
BK_SCHED_DOM="1"                          # day for monthly (1-28) or last (last day of the month)
BK_SCHED_TIME="03:00"                     # time of day HH:MM
BK_UNIT="safetui-dbbackup"               # systemd unit name of the scheduled backup

declare -A BK_SEL=()    # paths picked in the file browser (an empty value means unselected)
declare -A BK_USED=()   # backup paths already created in this run

# The settings file is never executed; it is read line by line (key=value) - safe even with special characters in the password
# Read package defaults first, then the settings saved by the user (the later one wins)
bk_load() { bk_load_file "$VENDOR_DEFAULTS"; bk_load_file "$BK_CONF"; }
bk_load_file() {
    [[ -r "$1" ]] || return 0
    local k v
    while IFS='=' read -r k v; do
        case "$k" in
            DB_HOME)      BK_DB_HOME="$v" ;;
            DB_USER)      BK_DB_USER="$v" ;;
            DB_PASS)      BK_DB_PASS="$v" ;;
            DB_NAME)      BK_DB_NAME="$v" ;;
            DB_DIR)       BK_DB_DIR="$v" ;;
            DB_KEEP_DAYS) [[ "$v" =~ ^[0-9]{1,4}$ ]] && BK_DB_KEEP_DAYS="$v" ;;
            DEST_MODE)    [[ "$v" == same || "$v" == dir ]] && BK_DEST_MODE="$v" ;;
            DEST_DIR)     BK_DEST_DIR="$v" ;;
            SUFFIX)       BK_SUFFIX="$v" ;;
            EXISTS)       [[ "$v" =~ ^(ask|number|overwrite|skip)$ ]] && BK_EXISTS="$v" ;;
            DB_COMPRESS)  [[ "$v" == yes || "$v" == no ]] && BK_DB_COMPRESS="$v" ;;
            TAR)          [[ "$v" == yes || "$v" == no ]] && BK_TAR="$v" ;;
            SCHED)        [[ "$v" =~ ^(off|daily|weekly|monthly)$ ]] && BK_SCHED="$v" ;;
            SCHED_DOW)    [[ "$v" =~ ^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)$ ]] && BK_SCHED_DOW="$v" ;;
            SCHED_DOM)    [[ "$v" =~ ^([1-9]|1[0-9]|2[0-8]|last)$ ]] && BK_SCHED_DOM="$v" ;;
            SCHED_TIME)   [[ "$v" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && BK_SCHED_TIME="$v" ;;
        esac
    done <"$1"
}

# Safety check for a backup folder under a world-writable folder (such as /tmp).
# If another account creates a folder or a link on that path first, root could write the backup
# to the wrong place or hand its contents to that account. So every component below a
# world-writable folder must be owned by root, not writable by others, and not a link. Prints the reason and returns 1 on a problem.
bk_dir_safe() {
    local c="$1" b mode owner
    local -a below=()
    while [[ -n "$c" && "$c" != "/" ]]; do
        if [[ -e "$c" || -L "$c" ]]; then
            mode="$(stat -L -c %a -- "$c" 2>/dev/null)"; mode="${mode: -4}"
            if [[ ! -L "$c" && -d "$c" ]] && (( 8#${mode:-0} & 8#0002 )); then
                if (( ! ( 8#${mode:-0} & 8#1000 ) )); then
                    echo "$(L '누구나 쓸 수 있는 폴더라 백업 위치로 쓸 수 없습니다' 'world-writable folder, not safe for backups'): $c"; return 1
                fi
                for b in "${below[@]}"; do
                    owner="$(stat -c %u -- "$b" 2>/dev/null)"; mode="$(stat -c %a -- "$b" 2>/dev/null)"
                    if [[ -L "$b" ]]; then
                        echo "$(L '백업 경로에 링크가 끼어 있습니다' 'the backup path contains a symbolic link'): $b"; return 1
                    elif [[ "$owner" != 0 ]] || (( 8#${mode:-0} & 8#0022 )); then
                        echo "$(L 'root 가 아닌 계정이 만들었거나 남이 쓸 수 있는 폴더입니다' 'not owned by root, or writable by others'): $b"
                        echo "$(L "($c 아래는 누구나 폴더를 만들 수 있습니다. 그 폴더를 지우거나 백업 설정에서 다른 위치를 지정하세요)" "(anyone can create folders under $c. Remove that folder or choose another location in Backup settings)")"
                        return 1
                    fi
                done
                return 0
            fi
            below+=("$c")
        fi
        c="$(dirname "$c")"
    done
    return 0
}

# Contains the DB password, so save it readable by root only (600)
bk_save() {
    local tmp
    mkdir -p "$(dirname "$BK_CONF")" 2>/dev/null
    tmp="$(mktemp "${BK_CONF}.XXXXXX")" || return 1
    chmod 600 "$tmp"
    {
        printf 'DB_HOME=%s\n'      "$BK_DB_HOME"
        printf 'DB_USER=%s\n'      "$BK_DB_USER"
        printf 'DB_PASS=%s\n'      "$BK_DB_PASS"
        printf 'DB_NAME=%s\n'      "$BK_DB_NAME"
        printf 'DB_DIR=%s\n'       "$BK_DB_DIR"
        printf 'DB_KEEP_DAYS=%s\n' "$BK_DB_KEEP_DAYS"
        printf 'DEST_MODE=%s\n'    "$BK_DEST_MODE"
        printf 'DEST_DIR=%s\n'     "$BK_DEST_DIR"
        printf 'SUFFIX=%s\n'       "$BK_SUFFIX"
        printf 'EXISTS=%s\n'       "$BK_EXISTS"
        printf 'DB_COMPRESS=%s\n'  "$BK_DB_COMPRESS"
        printf 'TAR=%s\n'          "$BK_TAR"
        printf 'SCHED=%s\n'        "$BK_SCHED"
        printf 'SCHED_DOW=%s\n'    "$BK_SCHED_DOW"
        printf 'SCHED_DOM=%s\n'    "$BK_SCHED_DOM"
        printf 'SCHED_TIME=%s\n'   "$BK_SCHED_TIME"
    } >"$tmp"
    mv -f "$tmp" "$BK_CONF"
}

# Replace $today / $time in the suffix with real values (plain text substitution, not shell expansion)
bk_suffix() {
    local s="$BK_SUFFIX"
    s="${s//\$today/$(date +%Y%m%d)}"
    s="${s//\$time/$(date +%H%M%S)}"
    printf '%s' "$s"
}

bk_exists_label() {
    case "${1:-$BK_EXISTS}" in
        ask)       L '매번 묻기' 'Ask each time' ;;
        number)    L '번호 붙여 새로 만들기 (_1, _2 …)' 'Add a number (_1, _2 …)' ;;
        overwrite) L '덮어쓰기' 'Overwrite' ;;
        skip)      L '건너뛰기' 'Skip' ;;
    esac
}
bk_dest_label() {
    if [[ "$BK_DEST_MODE" == dir ]]; then printf '%s' "$BK_DEST_DIR"
    else L '원본과 같은 위치' 'Same folder as the original'; fi
}
bk_onoff_label() { if [[ "$1" == yes ]]; then L '켜짐' 'on'; else L '꺼짐' 'off'; fi; }
bk_dbname_label() { if [[ -n "$BK_DB_NAME" ]]; then printf '%s' "$BK_DB_NAME"; else L '(전체 DB)' '(all databases)'; fi; }

valid_abs_dir() { [[ "$1" == /* && "$1" != "/" && "$1" != *$'\n'* ]]; }

# --- settings --------------------------------------------------------------
bk_settings() {
    local choice v pw
    while true; do
        if [[ -n "$BK_DB_PASS" ]]; then pw="$(L '(설정됨)' '(set)')"; else pw="$(L '(없음)' '(none)')"; fi
        choice="$(dlg --title "$(L '백업 설정' 'Backup settings')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '바꿀 항목을 선택하세요. 바꾸면 바로 저장됩니다.' 'Select an item to change. Changes are saved immediately.')" \
            "$DLG_H" "$DLG_W" "$MENU_H" \
            1 "$(L 'DB 설치 경로' 'DB install path')        : $BK_DB_HOME" \
            2 "$(L 'DB 계정' 'DB user')             : $BK_DB_USER" \
            3 "$(L 'DB 비밀번호' 'DB password')         : $pw" \
            4 "$(L '백업할 DB 이름' 'Database name')      : $(bk_dbname_label)" \
            5 "$(L 'DB 백업 저장 위치' 'DB backup folder')   : $BK_DB_DIR" \
            6 "$(L 'DB 백업 보관 기간' 'DB backup retention')   : $( (( BK_DB_KEEP_DAYS > 0 )) && echo "${BK_DB_KEEP_DAYS}$(L '일' ' days')" || L '지우지 않음' 'keep forever')" \
            7 "$(L 'DB 백업 압축(.gz)' 'DB backup gzip')   : $(bk_onoff_label "$BK_DB_COMPRESS")" \
            8 "$(L '파일 백업 저장 위치' 'File backup folder') : $(bk_dest_label)" \
            9 "$(L '백업 이름 뒤 문자열' 'Backup name suffix') : ${BK_SUFFIX:-$(L '(없음)' '(none)')}" \
            10 "$(L '같은 이름이 있을 때' 'If it already exists') : $(bk_exists_label)" \
            11 "$(L '여러 개는 tar 로 묶기' 'Bundle many into tar') : $(bk_onoff_label "$BK_TAR")")" || return
        case "$choice" in
            1) v="$(dlg_input "$(L 'DB 설치 경로' 'DB install path')" \
                    "$(L 'MariaDB 가 설치된 경로를 입력하세요.\n(이 경로 아래 bin/mariadb-dump 를 사용합니다)' \
                         'Enter the MariaDB install path.\n(bin/mariadb-dump under this path is used)')" "$BK_DB_HOME")" || continue
               v="${v%/}"
               if valid_abs_dir "$v"; then BK_DB_HOME="$v"; bk_save
                   bk_dump_bin >/dev/null || msg "$(L '[주의] MariaDB 를 찾지 못함' '[CAUTION] MariaDB not found')" \
                       "$(L '설정은 저장했지만, 이 경로에서 mariadb-dump 를 찾지 못했습니다.' 'Saved, but mariadb-dump was not found under this path.')\n\n  $v/bin/" 10
               else msg "$(L '입력 오류' 'Invalid input')" "$(L '/ 로 시작하는 경로를 입력하세요.' 'Enter an absolute path starting with /.')" 8; fi ;;
            2) v="$(dlg_input "$(L 'DB 계정' 'DB user')" "$(L '덤프에 사용할 DB 계정을 입력하세요.' 'Enter the DB user for the dump.')" "$BK_DB_USER")" || continue
               if [[ -n "$v" && "$v" != *[[:space:]]* ]]; then BK_DB_USER="$v"; bk_save
               else msg "$(L '입력 오류' 'Invalid input')" "$(L '계정 이름을 공백 없이 입력하세요.' 'Enter a user name without spaces.')" 8; fi ;;
            3) v="$(dlg --title "$(L 'DB 비밀번호' 'DB password')" --insecure \
                    --passwordbox "$(L '비밀번호를 입력하세요. (입력한 글자는 * 로 표시)\n비밀번호가 없는 계정이면 비워 두고 확인을 누르세요.\n\n저장 위치: ' \
                                       'Enter the password (shown as *).\nLeave empty if the account has no password.\n\nStored in: ')${BK_CONF} $(L '(root 만 읽기 가능)' '(root-only)')" \
                    13 "$DLG_W")" || continue
               if [[ "$v" == *$'\n'* ]]; then msg "$(L '입력 오류' 'Invalid input')" "$(L '줄바꿈은 쓸 수 없습니다.' 'Line breaks are not allowed.')" 8
               else BK_DB_PASS="$v"; bk_save; fi ;;
            4) v="$(dlg_input "$(L '백업할 DB 이름' 'Database name')" \
                    "$(L '덤프할 DB 이름을 입력하세요. 여러 개는 공백으로 구분합니다.\n비워 두면 전체 DB 를 한 파일로 백업합니다.' \
                         'Enter database name(s), separated by spaces.\nLeave empty to dump all databases into one file.')" "$BK_DB_NAME")" || continue
               v="$(printf '%s' "$v" | xargs 2>/dev/null)"
               if [[ -z "$v" || "$v" =~ ^[A-Za-z0-9_$-]+(\ [A-Za-z0-9_$-]+)*$ ]]; then BK_DB_NAME="$v"; bk_save
               else msg "$(L '입력 오류' 'Invalid input')" "$(L 'DB 이름은 영문/숫자/_/-/$ 만 쓸 수 있습니다.' 'Use only letters, digits, _, - and $.')" 8; fi ;;
            5) v="$(dlg_input "$(L 'DB 백업 저장 위치' 'DB backup folder')" \
                    "$(L 'DB 덤프 파일(.sql.gz)을 저장할 폴더를 입력하세요. 없으면 만듭니다.' 'Folder for dump files (.sql.gz). Created if missing.')" "$BK_DB_DIR")" || continue
               v="${v%/}"
               if valid_abs_dir "$v"; then BK_DB_DIR="$v"; bk_save
               else msg "$(L '입력 오류' 'Invalid input')" "$(L '/ 로 시작하는 폴더 경로를 입력하세요. ( / 자체는 안 됩니다)' 'Enter an absolute folder path (not / itself).')" 8; fi ;;
            6) v="$(dlg_input "$(L 'DB 백업 보관 기간' 'DB backup retention')" \
                    "$(L '며칠 동안 보관할지 숫자로 입력하세요. (0 = 지우지 않음)\n이 기간이 지난 DB 백업 파일은 다음 DB 백업이 성공한 뒤 지웁니다.' \
                         'Days to keep (0 = keep forever).\nOlder DB backup files are removed after the next successful DB backup.')" "$BK_DB_KEEP_DAYS")" || continue
               if [[ "$v" =~ ^[0-9]{1,4}$ ]]; then BK_DB_KEEP_DAYS="$((10#$v))"; bk_save
               else msg "$(L '입력 오류' 'Invalid input')" "$(L '0~9999 사이 숫자를 입력하세요.' 'Enter a number between 0 and 9999.')" 8; fi ;;
            7) v="$(dlg --title "$(L 'DB 백업 압축' 'DB backup compression')" --default-item "$BK_DB_COMPRESS" \
                    --menu "$(L 'DB 덤프를 gzip 으로 압축할까요?\n압축하면 보통 1/5~1/10 크기가 되고, 끄면 바로 열어 볼 수 있는 .sql 로 저장합니다.' \
                               'Compress DB dumps with gzip?\nCompressed dumps are usually 5-10x smaller; off saves plain .sql.')" 12 "$DLG_W" 2 \
                    yes "$(L '켜짐 — DB이름_날짜_시각.sql.gz' 'on  — name_date_time.sql.gz')" \
                    no  "$(L '꺼짐 — DB이름_날짜_시각.sql' 'off — name_date_time.sql')")" || continue
               BK_DB_COMPRESS="$v"; bk_save ;;
            11) v="$(dlg --title "$(L '여러 개는 tar 로 묶기' 'Bundle many into tar')" --default-item "$BK_TAR" \
                    --menu "$(L '파일·폴더를 2개 이상 골랐을 때 tar 파일 하나로 묶어 보관할까요?\n(1개만 고르면 이 설정과 상관없이 그대로 복사합니다)' \
                               'When 2 or more items are selected, bundle them into one tar file?\n(A single item is always copied as is)')" 12 "$DLG_W" 2 \
                    yes "$(L '켜짐 — backup<뒤 문자열>.tar 하나로 묶음' 'on  — one backup<suffix>.tar')" \
                    no  "$(L '꺼짐 — 항목마다 따로 복사' 'off — copy each item separately')")" || continue
               BK_TAR="$v"; bk_save ;;
            8) v="$(dlg --title "$(L '파일 백업 저장 위치' 'File backup folder')" --default-item "$BK_DEST_MODE" \
                    --menu "$(L '파일·폴더 백업본을 어디에 둘까요?' 'Where should file/folder backups go?')" 11 "$DLG_W" 2 \
                    same "$(L '원본과 같은 위치 (예: /etc/a.conf → /etc/a.conf_날짜)' 'Same folder as the original')" \
                    dir  "$(L '폴더를 지정 (모든 백업본을 한 폴더에)' 'A folder I specify')")" || continue
               if [[ "$v" == dir ]]; then
                   v="$(dlg_input "$(L '파일 백업 저장 위치' 'File backup folder')" \
                        "$(L '백업본을 모아 둘 폴더를 입력하세요. 없으면 만듭니다.' 'Folder to collect backups in. Created if missing.')" "$BK_DEST_DIR")" || continue
                   v="${v%/}"
                   if valid_abs_dir "$v"; then BK_DEST_DIR="$v"; BK_DEST_MODE="dir"; bk_save
                   else msg "$(L '입력 오류' 'Invalid input')" "$(L '/ 로 시작하는 폴더 경로를 입력하세요. ( / 자체는 안 됩니다)' 'Enter an absolute folder path (not / itself).')" 8; fi
               else BK_DEST_MODE="same"; bk_save; fi ;;
            9) v="$(dlg_input "$(L '백업 이름 뒤 문자열' 'Backup name suffix')" \
                    "$(L '백업본 이름 뒤에 붙일 문자열을 입력하세요.\n  $today = 오늘 날짜(YYYYMMDD),  $time = 현재 시각(HHMMSS)\n예) _$today  →  server.xml_20261001' \
                         'Text appended to the backup name.\n  $today = date (YYYYMMDD),  $time = time (HHMMSS)\ne.g. _$today  ->  server.xml_20261001')" "$BK_SUFFIX")" || continue
               if [[ "$v" == */* || "$v" == *$'\n'* ]]; then
                   msg "$(L '입력 오류' 'Invalid input')" "$(L '/ 는 쓸 수 없습니다.' '/ is not allowed.')" 8
               elif [[ -z "$v" && "$BK_DEST_MODE" == same ]]; then
                   msg "$(L '입력 오류' 'Invalid input')" "$(L '저장 위치가 "원본과 같은 위치"일 때는 비워 둘 수 없습니다.\n(백업본 이름이 원본과 같아집니다)' 'Cannot be empty when backups go to the same folder as the original.')" 9
               else BK_SUFFIX="$v"; bk_save; fi ;;
            10) v="$(dlg --title "$(L '같은 이름이 있을 때' 'If it already exists')" --default-item "$BK_EXISTS" \
                    --menu "$(L '같은 이름의 백업본이 이미 있으면 어떻게 할까요?' 'What if a backup with the same name already exists?')" 13 "$DLG_W" 4 \
                    ask       "$(bk_exists_label ask)" \
                    number    "$(bk_exists_label number)" \
                    overwrite "$(bk_exists_label overwrite)" \
                    skip      "$(bk_exists_label skip)")" || continue
               BK_EXISTS="$v"; bk_save ;;
        esac
    done
}

# --- file browser -----------------------------------------------------------
bk_hsize() {  # bytes -> human readable size (result in REPLY)
    local n="$1"
    if   (( n < 1024 ));       then REPLY="$n"
    elif (( n < 1048576 ));    then REPLY="$(( n / 1024 ))K"
    elif (( n < 1073741824 )); then REPLY="$(( n / 1048576 ))M"
    else                            REPLY="$(( n / 1073741824 ))G"; fi
}

bk_sel_count() {
    local p n=0
    for p in "${!BK_SEL[@]}"; do [[ -n "${BK_SEL[$p]}" ]] && (( n++ )); done
    echo "$n"
}

# Arrow keys move, Space selects, Enter opens a folder. Selections are kept while moving between folders.
# Symbolic links are not backed up, so they are not listed.
# Returns: 0 = start the backup, 1 = cancel
bk_browse() {
    local cur="$1" focus="" rows cols H W LH out rc
    local typ size mt own mode name tag info full cur_tag line inside p other
    local -a args tags lines
    while true; do
        read -r rows cols < <(stty size 2>/dev/null)
        [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
        [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
        H=$(( rows - 3 )); (( H < 18 )) && H=18
        W=$(( cols - 4 )); (( W > 110 )) && W=110
        LH=$(( H - 10 ))

        args=(); tags=()
        [[ "$cur" != "/" ]] && args+=(".." "$(L '[ 상위 폴더로 ]' '[ parent folder ]')" off)
        while IFS=$'\t' read -r -d '' typ size mt own mode name; do
            full="${cur%/}/$name"
            if [[ "$typ" == d ]]; then
                tag="$name/"
                printf -v info '%6s %-8s %4s %s' '<DIR>' "$own" "$mode" "$mt"
            else
                tag="$name"
                bk_hsize "$size"
                printf -v info '%6s %-8s %4s %s' "$REPLY" "$own" "$mode" "$mt"
            fi
            tags+=("$tag")
            if [[ -n "${BK_SEL[$full]:-}" ]]; then args+=("$tag" "$info" on); else args+=("$tag" "$info" off); fi
        done < <(find "$cur" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) ! -name $'*\n*' ! -name $'*\t*' \
                     -printf '%y\t%s\t%Ty-%Tm-%Td\t%u\t%m\t%f\0' 2>/dev/null | LC_ALL=C sort -z -t $'\t' -k1,1 -k6)
        if (( ${#args[@]} == 0 )); then args+=(".." "$(L '[ 상위 폴더로 ]' '[ parent folder ]')" off); fi

        inside=""
        for p in "${!BK_SEL[@]}"; do
            [[ -n "${BK_SEL[$p]}" && ( "$cur" == "$p" || "$cur" == "$p"/* ) ]] && { inside="$p"; break; }
        done
        other=0
        for p in "${!BK_SEL[@]}"; do
            [[ -n "${BK_SEL[$p]}" && "$(dirname "$p")" != "$cur" ]] && (( other++ ))
        done
        info="$(L '위치' 'Path'): $cur\n"
        if [[ -n "$inside" ]]; then info+="$(L '※ 이 폴더는 통째로 선택되어 있습니다 (안의 파일을 따로 고를 필요 없음)' '* this whole folder is already selected')"
        elif (( other > 0 )); then info+="$(L '다른 위치에서 선택해 둔 항목' 'Selected in other folders'): ${other}$(L '개 (유지됨)' ' (kept)')"
        else info+="$(L '[*] 표시한 항목이 백업됩니다. 폴더를 표시하면 안의 파일까지 모두 백업됩니다.' 'Items marked [*] are backed up. A marked folder includes everything inside.')"; fi
        info+="\n$(L '[↑↓] 이동  [Space] 선택/해제  [Enter] 폴더 열기  [Tab] 버튼으로 이동' \
                     '[Up/Down] move  [Space] select  [Enter] open folder  [Tab] buttons')"

        flush_input
        out="$(dialog --backtitle "$BACKTITLE" --title "$(L '백업할 파일·폴더 선택' 'Select files/folders to back up')" \
            --separate-output --help-status \
            --ok-label "$(L '백업 시작' 'Back up')" \
            --extra-button --extra-label "$(L '경로 입력' 'Go to path')" \
            --cancel-label "$(L '취소' 'Cancel')" \
            --help-button --help-label "$(L '열기' 'Open')" \
            --default-button help ${focus:+--default-item "$focus"} \
            --checklist "$info" "$H" "$W" "$LH" "${args[@]}" 3>&1 1>&2 2>&3)"
        rc=$?
        (( rc == 0 || rc == 2 || rc == 3 )) || return 1

        mapfile -t lines <<<"$out"
        cur_tag=""
        if (( rc == 2 )); then cur_tag="${lines[0]#HELP }"; lines=("${lines[@]:1}"); fi
        # apply the check marks on this screen to the selection list
        for tag in "${tags[@]}"; do BK_SEL["${cur%/}/${tag%/}"]=""; done
        for line in "${lines[@]}"; do
            [[ -z "$line" || "$line" == ".." ]] && continue
            BK_SEL["${cur%/}/${line%/}"]=1
        done

        case "$rc" in
            0)  if (( $(bk_sel_count) == 0 )); then
                    msg "$(L '선택된 항목 없음' 'Nothing selected')" \
                        "$(L '백업할 파일이나 폴더에서 Space 를 눌러 [*] 표시를 한 뒤\n<백업 시작> 을 누르세요.' \
                             'Press Space on files or folders to mark them [*],\nthen choose <Back up>.')" 9
                    continue
                fi
                return 0 ;;
            3)  line="$(dlg_input "$(L '경로 입력' 'Go to path')" "$(L '이동할 폴더 경로를 입력하세요.' 'Enter a folder path to go to.')" "$cur")" || continue
                if [[ -d "$line" ]]; then cur="$(cd "$line" && pwd -P)"; focus=""
                else msg "$(L '입력 오류' 'Invalid input')" "$(L '폴더가 없습니다:' 'No such folder:')\n  $line" 8; fi ;;
            2)  case "$cur_tag" in
                    "..") focus="$(basename "$cur")/"; cur="$(dirname "$cur")" ;;
                    */)   cur="${cur%/}/${cur_tag%/}"; focus="" ;;
                    "")   ;;
                    *)    full="${cur%/}/$cur_tag"   # Enter on a file = select / unselect
                          if [[ -n "${BK_SEL[$full]:-}" ]]; then BK_SEL["$full"]=""; else BK_SEL["$full"]=1; fi
                          focus="$cur_tag" ;;
                esac ;;
        esac
    done
}

# --- run a file / folder backup ----------------------------------------------
# $1=source. Puts a result line in BK_MSG and returns 0=ok 1=failed 2=skipped 3=stop all.
# cp -a preserves owner, group, mode, timestamps and SELinux label.
bk_copy_one() {
    local src="$1" base destdir dest part policy n a b lnk ldir
    base="$(basename "$src")"
    if [[ "$BK_DEST_MODE" == dir ]]; then destdir="$BK_DEST_DIR"; else destdir="$(dirname "$src")"; fi
    if [[ -d "$src" && ( "$destdir" == "$src" || "$destdir" == "$src"/* ) ]]; then
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(L '저장 위치가 이 폴더 안에 있어 백업할 수 없습니다' 'the backup folder is inside this folder'): $destdir"
        return 1
    fi
    if ! bk_dir_safe "$destdir" >"$TMP_DIR/cp.err" || ! mkdir -p -- "$destdir" 2>>"$TMP_DIR/cp.err" \
         || ! bk_dir_safe "$destdir" >"$TMP_DIR/cp.err"; then
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    dest="${destdir%/}/${base}${BK_SFX}"
    if [[ "$dest" == "$src" ]]; then
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(L '백업본 이름이 원본과 같습니다 (설정의 뒤 문자열을 확인하세요)' 'backup name equals the original (check the suffix setting)')"
        return 1
    fi
    # Never touch a destination that is a folder containing the source (e.g. overwriting /a/b with something inside /a/b)
    if [[ "$src" == "$dest"/* ]]; then
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(L '백업본 이름이 원본이 들어 있는 폴더와 같습니다' 'backup name equals a folder that contains the original'): $dest"
        return 1
    fi
    if [[ -e "$dest" || -L "$dest" || -n "${BK_USED[$dest]:-}" ]]; then
        policy="$BK_EXISTS"
        # Never overwrite a backup created earlier in this run (another source with the same name)
        [[ -n "${BK_USED[$dest]:-}" ]] && policy="number"
        if [[ "$policy" == ask ]]; then
            policy="$(dlg --title "$(L '[주의] 같은 이름의 백업본이 있습니다' '[CAUTION] Backup already exists')" \
                --cancel-label "$(L '전체 중단' 'Stop all')" \
                --menu "$dest\n\n$(L '어떻게 할까요?' 'What should be done?')" 14 "$DLG_W" 3 \
                number    "$(bk_exists_label number)" \
                overwrite "$(bk_exists_label overwrite)" \
                skip      "$(bk_exists_label skip)")" || { BK_MSG="$(L '중단' 'STOPPED')  $src"; return 3; }
        fi
        case "$policy" in
            skip)   BK_MSG="$(L '건너뜀' 'SKIPPED') $src\n        $(L '이미 있음' 'already exists'): $dest"; return 2 ;;
            number) n=1; while [[ -e "${dest}_$n" || -L "${dest}_$n" || -n "${BK_USED[${dest}_$n]:-}" ]]; do (( n++ )); done
                    dest="${dest}_$n" ;;
        esac
    fi
    # Copy under a temporary name and rename, so a failure never leaves a half-copied backup behind
    part="${dest}.safetui-part.$$"
    rm -rf -- "$part"
    if ! cp -a -- "$src" "$part" 2>"$TMP_DIR/cp.err"; then
        rm -rf -- "$part"
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    # Links are not backed up, so remove them. Removing changes the folder mtime, so restore it from the source
    if [[ -d "$part" ]]; then
        while IFS= read -r -d '' lnk; do
            rm -f -- "$lnk"
            ldir="$(dirname "$lnk")"
            touch -r "${src}${ldir#"$part"}" -- "$ldir" 2>/dev/null
        done < <(find "$part" -type l -print0 2>/dev/null)
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then rm -rf -- "$dest"; fi
    if ! mv -T -- "$part" "$dest" 2>"$TMP_DIR/cp.err"; then
        rm -rf -- "$part"
        BK_MSG="$(L '실패' 'FAILED')  $src\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    BK_USED["$dest"]=1
    a="$(stat -c '%U:%G %a' -- "$src" 2>/dev/null)"; b="$(stat -c '%U:%G %a' -- "$dest" 2>/dev/null)"
    BK_MSG="$(L '완료' 'OK')    $src\n     →  $dest\n        $(L '소유자·권한' 'owner/mode'): $b"
    [[ "$a" != "$b" ]] && BK_MSG+="  $(L '(원본과 다름' '(differs from original'): $a)"
    logger -t safetui-backup "file backup: $src -> $dest" 2>/dev/null
    bk_hist_add "$src" "$dest"
    return 0
}

# Bundle several items into one tar file. Arguments = sources. Same return values as bk_copy_one.
# Paths are stored relative to / (--selinux --acls --xattrs -p) keeping owner, mode and label; links are left out.
bk_tar_all() {
    local destdir dest part policy n p common cnt
    local -a rcs
    if [[ "$BK_DEST_MODE" == dir ]]; then destdir="$BK_DEST_DIR"
    else   # common parent folder of the sources
        common="$(dirname "$1")"
        for p in "$@"; do
            while [[ "$common" != "/" && "$p" != "$common"/* ]]; do common="$(dirname "$common")"; done
        done
        destdir="$common"
    fi
    for p in "$@"; do
        if [[ -d "$p" && ( "$destdir" == "$p" || "$destdir" == "$p"/* ) ]]; then
            BK_MSG="$(L '실패' 'FAILED')  $(L 'tar 묶음' 'tar bundle')\n        $(L '저장 위치가 백업할 폴더 안에 있습니다' 'the backup folder is inside a selected folder'): $destdir"
            return 1
        fi
    done
    if ! bk_dir_safe "$destdir" >"$TMP_DIR/cp.err" || ! mkdir -p -- "$destdir" 2>>"$TMP_DIR/cp.err" \
         || ! bk_dir_safe "$destdir" >"$TMP_DIR/cp.err"; then
        BK_MSG="$(L '실패' 'FAILED')  $(L 'tar 묶음' 'tar bundle')\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    dest="${destdir%/}/backup${BK_SFX}.tar"
    if [[ -e "$dest" || -L "$dest" ]]; then
        policy="$BK_EXISTS"
        if [[ "$policy" == ask ]]; then
            policy="$(dlg --title "$(L '[주의] 같은 이름의 백업본이 있습니다' '[CAUTION] Backup already exists')" \
                --cancel-label "$(L '전체 중단' 'Stop all')" \
                --menu "$dest\n\n$(L '어떻게 할까요?' 'What should be done?')" 14 "$DLG_W" 3 \
                number    "$(bk_exists_label number)" \
                overwrite "$(bk_exists_label overwrite)" \
                skip      "$(bk_exists_label skip)")" || { BK_MSG="$(L '중단' 'STOPPED')  $dest"; return 3; }
        fi
        case "$policy" in
            skip)   BK_MSG="$(L '건너뜀' 'SKIPPED') $(L 'tar 묶음' 'tar bundle')\n        $(L '이미 있음' 'already exists'): $dest"; return 2 ;;
            number) n=1; while [[ -e "${destdir%/}/backup${BK_SFX}_$n.tar" ]]; do (( n++ )); done
                    dest="${destdir%/}/backup${BK_SFX}_$n.tar" ;;
        esac
    fi
    part="${dest}.safetui-part.$$"
    rm -f -- "$part"
    ( umask 077
      find "$@" ! -type l -print0 2>>"$TMP_DIR/cp.err" | sed -z 's|^/||' \
        | tar -C / --null --no-recursion -T - --selinux --acls --xattrs -cpf "$part" 2>"$TMP_DIR/cp.err"
      exit "${PIPESTATUS[2]}" )
    n=$?
    if (( n > 1 )) || [[ ! -s "$part" ]]; then   # tar exit code 1 = a file changed while being read (warning), 2 or more = failure
        rm -f -- "$part"
        BK_MSG="$(L '실패' 'FAILED')  $(L 'tar 묶음' 'tar bundle')\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    if ! mv -f -T -- "$part" "$dest" 2>"$TMP_DIR/cp.err"; then
        rm -f -- "$part"
        BK_MSG="$(L '실패' 'FAILED')  $(L 'tar 묶음' 'tar bundle')\n        $(head -n 1 "$TMP_DIR/cp.err")"; return 1
    fi
    cnt="$(tar -tf "$dest" 2>/dev/null | wc -l)"
    bk_hsize "$(stat -c %s -- "$dest" 2>/dev/null || echo 0)"
    BK_MSG="$(L '완료' 'OK')    $#$(L '개 항목을 tar 파일 하나로 묶었습니다' ' items bundled into one tar file')\n     →  $dest\n        $(L '담긴 파일·폴더' 'entries'): ${cnt}$(L '개' ''),  $(L '크기' 'size'): $REPLY\n"
    for p in "$@"; do
        BK_MSG+="        - $p\n"
        logger -t safetui-backup "file backup (tar): $p -> $dest" 2>/dev/null
        bk_hist_add "$p" "$dest"
    done
    BK_MSG+="\n        $(L '내용 보기' 'List')     : tar -tvf $dest\n        $(L '원래 자리에 풀기' 'Restore in place') : tar -C / -xpf $dest\n        $(L '다른 곳에 풀기' 'Extract elsewhere')  : tar -C <$(L '폴더' 'dir')> -xpf $dest"
    return 0
}

bk_files() {
    local start="/" h p q skip rc i n ok=0 fail=0 skipped=0 list more usetar=0 tarline=""
    local -a all items
    bk_load
    if [[ -z "$BK_SUFFIX" && "$BK_DEST_MODE" == same ]]; then
        msg "$(L '설정 확인 필요' 'Check settings')" "$(L '백업 이름 뒤 문자열이 비어 있습니다. 백업 설정에서 먼저 지정하세요.' 'The backup name suffix is empty. Set it in Backup settings first.')" 8
        return
    fi
    # Start in the home of the account that ran sudo; root's home (/root) when logged in as root; otherwise /
    h="$(getent passwd "${SUDO_USER:-root}" 2>/dev/null | cut -d: -f6)"
    [[ -n "$h" && -d "$h" ]] && start="$h"
    BK_SEL=(); BK_USED=()
    bk_browse "$start" || return

    # Tidy the selection: items inside an already selected folder are copied with it, so drop them
    all=(); items=()
    while IFS= read -r -d '' p; do all+=("$p"); done < <(
        for p in "${!BK_SEL[@]}"; do [[ -n "${BK_SEL[$p]}" ]] && printf '%s\0' "$p"; done | LC_ALL=C sort -z)
    for p in "${all[@]}"; do
        [[ -e "$p" && ! -L "$p" ]] || continue
        case "$p" in /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*)
            msg "$(L '백업할 수 없는 위치' 'Cannot back up this location')" \
                "$(L '시스템이 실시간으로 만드는 가상 폴더(/proc, /sys, /dev, /run)는 백업할 수 없어 제외합니다.' \
                     'Virtual system folders (/proc, /sys, /dev, /run) cannot be backed up and are skipped.')\n\n  $p" 10
            continue ;;
        esac
        skip=0
        for q in "${items[@]}"; do [[ "$p" == "$q"/* ]] && { skip=1; break; }; done
        (( skip )) || items+=("$p")
    done
    n=${#items[@]}
    (( n > 0 )) || return

    BK_SFX="$(bk_suffix)"
    if [[ "$BK_TAR" == yes ]] && (( n > 1 )); then
        usetar=1
        tarline="$(L 'tar 로 묶기  :' 'Bundle       :') $(L '켜짐 — backup' 'on — backup')${BK_SFX}.tar $(L '하나로 묶음' '(one file)')\n"
    fi
    list=""; i=0
    for p in "${items[@]}"; do
        (( i++ )); (( i > 10 )) && break
        if [[ -d "$p" ]]; then list+="  $p/\n"; else list+="  $p\n"; fi
    done
    more=""; (( n > 10 )) && more="  … $(L '외' 'and') $(( n - 10 ))$(L '개' ' more')\n"
    yesno "$(L '백업 확인' 'Confirm backup')" \
"$(L '아래' 'Back up') ${n}$(L '개 항목을 백업합니다. 폴더는 안의 파일까지 모두 복사합니다.' ' item(s). Folders are copied with everything inside.')\n\n${list}${more}\n$(L '저장 위치    :' 'Destination  :') $(bk_dest_label)\n$(L '백업본 이름  :' 'Backup name  :') $(L '원본이름' 'name')${BK_SFX}\n$(L '이미 있을 때 :' 'If it exists :') $(bk_exists_label)\n${tarline}\n$(L '소유자·그룹·권한·수정시각은 원본과 똑같이 보존됩니다. 진행할까요?' 'Owner, group, mode and timestamps are preserved. Proceed?')" \
        "$(( (n > 10 ? 10 : n) + 15 ))" || return

    : >"$TMP_OUT"; i=0
    if (( usetar )); then
        dialog --backtitle "$BACKTITLE" --title "$(L '백업 중' 'Backing up')" \
            --infobox "$(L 'tar 파일로 묶는 중입니다…' 'Bundling into a tar file…')" 5 "$DLG_W"
        bk_tar_all "${items[@]}"; rc=$?
        printf '%b\n\n' "$BK_MSG" >>"$TMP_OUT"
        case "$rc" in 0) ok=$n ;; 1) fail=$n ;; 2) skipped=$n ;; esac
        items=()
    fi
    for p in "${items[@]}"; do
        (( i++ ))
        dialog --backtitle "$BACKTITLE" --title "$(L '백업 중' 'Backing up')" \
            --infobox "($i/$n)\n$p" 6 "$DLG_W"
        bk_copy_one "$p"; rc=$?
        printf '%b\n\n' "$BK_MSG" >>"$TMP_OUT"
        case "$rc" in 0) (( ok++ )) ;; 1) (( fail++ )) ;; 2) (( skipped++ )) ;; 3) break ;; esac
    done
    {
        printf '%s %d   %s %d   %s %d   (%s %d)\n\n' "$(L '완료' 'OK')" "$ok" "$(L '건너뜀' 'Skipped')" "$skipped" \
            "$(L '실패' 'Failed')" "$fail" "$(L '전체' 'total')" "$n"
        cat "$TMP_OUT"
    } | fold -s -w "$((DLG_W-6))" >"$TMP_DIR/bk.result"
    flush_input
    dialog --backtitle "$BACKTITLE" --exit-label "$(L '닫기' 'Close')" \
        --title "$(L '백업 결과' 'Backup result')" --textbox "$TMP_DIR/bk.result" "$DLG_H" "$DLG_W"
}

# --- file / folder backup history ---------------------------------------------
bk_hist_add() {  # $1=source $2=backup
    ( umask 077
      printf '%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" >>"$BK_HIST"
      # keep only the latest 1000 entries so the file does not grow forever
      if (( $(wc -l <"$BK_HIST") > 2000 )); then
          tail -n 1000 "$BK_HIST" >"$BK_HIST.tmp" && mv -f "$BK_HIST.tmp" "$BK_HIST"
      fi ) 2>/dev/null
}

bk_hist_text() {
    local ts src dest state total
    total="$(wc -l <"$BK_HIST" 2>/dev/null)"
    echo "$(L '최근 백업부터 보여 줍니다.' 'Newest first.')  ($(L '전체' 'total') ${total:-0}$(L '건, 최근 200건 표시' ', showing latest 200'))"
    echo
    while IFS=$'\t' read -r ts src dest; do
        [[ -n "$dest" ]] || continue
        if [[ -d "$dest" ]]; then state="$(L '있음 · 폴더' 'exists · folder')"
        elif [[ -e "$dest" ]]; then bk_hsize "$(stat -c %s -- "$dest" 2>/dev/null || echo 0)"; state="$(L '있음' 'exists') · $REPLY"
        else state="$(L '지워짐' 'removed')"; fi
        printf '%s  [%s]\n   %s\n → %s\n\n' "$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null)" "$state" "$src" "$dest"
    done < <(tac "$BK_HIST" 2>/dev/null | head -n 200)
}

bk_hist() {
    if [[ ! -s "$BK_HIST" ]]; then
        msg "$(L '파일·폴더 백업 이력' 'File backup history')" \
            "$(L '아직 백업 이력이 없습니다.\n파일·폴더 백업을 하면 여기에 기록됩니다.' 'No backup history yet.\nFile/folder backups are recorded here.')" 9
        return
    fi
    show_text "$(L '파일·폴더 백업 이력' 'File backup history')" bk_hist_text
}

# --- DB backup ----------------------------------------------------------------
# Find the dump program under the configured path and print its path. Returns 1 if there is none.
bk_dump_bin() {
    local b
    for b in "$BK_DB_HOME/bin/mariadb-dump" "$BK_DB_HOME/bin/mysqldump"; do
        [[ -x "$b" ]] && { printf '%s' "$b"; return 0; }
    done
    return 1
}

# Pass user / password through a root-only temporary file instead of the command line (visible in ps)
bk_write_cnf() {
    local u="$BK_DB_USER" p="$BK_DB_PASS"
    BK_CNF="$TMP_DIR/db.cnf"
    u="${u//\\/\\\\}"; u="${u//\"/\\\"}"
    p="${p//\\/\\\\}"; p="${p//\"/\\\"}"
    ( umask 077
      { echo "[client]"; printf 'user="%s"\n' "$u"
        [[ -n "$BK_DB_PASS" ]] && printf 'password="%s"\n' "$p"; } >"$BK_CNF" )
}

# DB backup files past the retention period (only files named the way this tool names them)
bk_db_old() {
    (( BK_DB_KEEP_DAYS > 0 )) || return 0
    [[ -d "$BK_DB_DIR" ]] || return 0
    find "$BK_DB_DIR" -maxdepth 1 -type f \
        \( -name '*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].sql.gz' \
        -o -name '*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].sql' \) \
        -mmin "+$(( BK_DB_KEEP_DAYS * 1440 ))" -print0 2>/dev/null
}

# $1=name used in the file name, the rest = dump target arguments. On success BK_LAST_FILE holds the path.
#  --single-transaction : read a consistent snapshot without locking tables (InnoDB)
#  --quick              : stream rows instead of buffering the result in memory
#  nice / ionice        : lower CPU / disk priority to reduce the load on the service
bk_db_dump_one() {
    local label="$1" out part ext="sql.gz"; shift
    [[ "$BK_DB_COMPRESS" == no ]] && ext="sql"
    out="$BK_DB_DIR/${label}_$(date +%Y%m%d_%H%M%S).$ext"
    part="$out.part"
    if [[ "$ext" == sql.gz ]]; then
        if ! ( umask 077; set -o pipefail
               nice -n 19 ionice -c 3 "$BK_DUMP" --defaults-extra-file="$BK_CNF" \
                   --single-transaction --quick --routines --triggers --events --hex-blob "$@" 2>>"$TMP_DIR/dump.err" \
                 | nice -n 19 gzip -c >"$part" ); then
            rm -f -- "$part"; return 1
        fi
    else
        if ! ( umask 077
               nice -n 19 ionice -c 3 "$BK_DUMP" --defaults-extra-file="$BK_CNF" \
                   --single-transaction --quick --routines --triggers --events --hex-blob "$@" \
                   2>>"$TMP_DIR/dump.err" >"$part" ); then
            rm -f -- "$part"; return 1
        fi
    fi
    # check that the dump was written to the end (completion marker on the last line)
    if ! { if [[ "$ext" == sql.gz ]]; then nice -n 19 gzip -dc -- "$part" 2>/dev/null | tail -n 5; else tail -n 5 -- "$part"; fi; } \
            | grep -q 'Dump completed'; then
        echo "$(L '덤프 파일이 끝까지 만들어지지 않았습니다.' 'The dump file is incomplete.')" >>"$TMP_DIR/dump.err"
        rm -f -- "$part"; return 1
    fi
    mv -f -- "$part" "$out" || return 1
    BK_LAST_FILE="$out"
    logger -t safetui-backup "db backup: $label -> $out" 2>/dev/null
}

# Run the DB backup without any screen (shared by the menu and the schedule). BK_DUMP must be set.
# Result: BK_DB_MADE (files created), BK_DB_REMOVED (number removed), BK_DB_SECS. The failure reason is in $TMP_DIR/dump.err
bk_db_run() {
    local db f ok=1 t0=$SECONDS
    local -a old=()
    BK_DB_MADE=(); BK_DB_REMOVED=0
    : >"$TMP_DIR/dump.err"
    while IFS= read -r -d '' f; do old+=("$f"); done < <(bk_db_old)
    bk_dir_safe "$BK_DB_DIR" >>"$TMP_DIR/dump.err" || return 1
    if ! ( umask 077; mkdir -p -- "$BK_DB_DIR" ) 2>>"$TMP_DIR/dump.err"; then return 1; fi
    bk_dir_safe "$BK_DB_DIR" >>"$TMP_DIR/dump.err" || return 1
    bk_write_cnf
    if [[ -z "$BK_DB_NAME" ]]; then
        if bk_db_dump_one "all-databases" --all-databases; then BK_DB_MADE+=("$BK_LAST_FILE"); else ok=0; fi
    else
        for db in $BK_DB_NAME; do
            if bk_db_dump_one "$db" "$db"; then BK_DB_MADE+=("$BK_LAST_FILE"); else ok=0; break; fi
        done
    fi
    rm -f -- "$BK_CNF"
    BK_DB_SECS=$(( SECONDS - t0 ))
    (( ok )) || return 1
    # remove old backups only after the new backup succeeded
    for f in "${old[@]}"; do rm -f -- "$f" && (( BK_DB_REMOVED++ )); done
    (( BK_DB_REMOVED > 0 )) && logger -t safetui-backup "db backup: removed $BK_DB_REMOVED file(s) older than ${BK_DB_KEEP_DAYS}d in $BK_DB_DIR" 2>/dev/null
    return 0
}

# Entry point for the schedule (systemd timer) and the command line:  safetui --db-backup
bk_db_cli() {
    local f
    bk_load
    if ! BK_DUMP="$(bk_dump_bin)"; then
        echo "safetui: $(L 'MariaDB 덤프 프로그램을 찾지 못했습니다' 'MariaDB dump program not found'): $BK_DB_HOME/bin/mariadb-dump" >&2
        return 1
    fi
    if bk_db_run; then
        for f in "${BK_DB_MADE[@]}"; do echo "$(L 'DB 백업 완료' 'DB backup done'): $f ($(du -h -- "$f" 2>/dev/null | cut -f1))"; done
        (( BK_DB_KEEP_DAYS > 0 )) && echo "$(L '보관 기간이 지나 지운 백업' 'Expired backups removed'): $BK_DB_REMOVED"
        return 0
    fi
    echo "safetui: $(L 'DB 백업 실패 (기존 백업은 지우지 않음)' 'DB backup failed (existing backups kept)')" >&2
    tail -n 8 "$TMP_DIR/dump.err" >&2
    return 1
}

bk_db() {
    local f n_old=0 free d
    bk_load
    if ! BK_DUMP="$(bk_dump_bin)"; then
        msg "$(L '[주의] MariaDB 가 설치되어 있지 않습니다' '[CAUTION] MariaDB is not installed')" \
"$(L '설정된 경로에서 MariaDB 덤프 프로그램을 찾지 못했습니다.' 'No MariaDB dump program was found under the configured path.')\n\n  $BK_DB_HOME/bin/mariadb-dump\n\n$(L 'MariaDB 가 다른 경로에 설치되어 있다면\n백업 → 백업 설정 → DB 설치 경로 를 고쳐 주세요.' \
     'If MariaDB is installed elsewhere, fix it in\nBackup -> Backup settings -> DB install path.')" 14
        return
    fi
    while IFS= read -r -d '' f; do (( n_old++ )); done < <(bk_db_old)
    d="$BK_DB_DIR"; while [[ ! -d "$d" ]]; do d="$(dirname "$d")"; done
    free="$(df -h --output=avail -- "$d" 2>/dev/null | tail -n 1 | tr -d ' ')"
    yesno "$(L 'DB 백업 확인' 'Confirm DB backup')" \
"$(L 'MariaDB 를 덤프합니다. 서비스는 멈추지 않습니다.' 'Dump MariaDB. The service keeps running.')\n\n$(L '대상 DB   :' 'Database  :') $(bk_dbname_label)\n$(L 'DB 계정   :' 'DB user   :') $BK_DB_USER\n$(L '저장 위치 :' 'Folder    :') $BK_DB_DIR  ($(L '남은 공간' 'free') ${free:-?})\n$(L '압축      :' 'Compress  :') $( [[ "$BK_DB_COMPRESS" == yes ]] && L '켜짐 (.sql.gz)' 'on (.sql.gz)' || L '꺼짐 (.sql)' 'off (.sql)')\n$(L '보관 기간 :' 'Retention :') $( (( BK_DB_KEEP_DAYS > 0 )) && echo "${BK_DB_KEEP_DAYS}$(L '일' ' days') — $(L '기간이 지난 백업' 'expired backups') ${n_old}$(L '개는 백업 성공 후 삭제' ' removed after success')" || L '지우지 않음' 'keep forever')\n\n$(L '테이블을 잠그지 않는 방식(--single-transaction)으로, 우선순위를 낮춰 실행합니다.\n진행할까요?' 'Runs without locking tables (--single-transaction) at low priority.\nProceed?')" 17 || return

    dialog --backtitle "$BACKTITLE" --title "$(L 'DB 백업 중' 'Backing up DB')" \
        --infobox "$(L 'DB 를 덤프하고 있습니다. DB 크기에 따라 시간이 걸릴 수 있습니다.\n끝날 때까지 기다려 주세요.' 'Dumping the database. This may take a while.\nPlease wait.')" 7 "$DLG_W"
    if ! bk_db_run; then
        msg "$(L 'DB 백업 — 실패' 'DB backup — Failed')" \
"$(L 'DB 덤프에 실패했습니다. 기존 백업 파일은 지우지 않았습니다.' 'The dump failed. No existing backups were removed.')\n\n$(tail -n 8 "$TMP_DIR/dump.err")\n\n$(L '계정·비밀번호·DB 이름은 백업 → 백업 설정 에서 확인하세요.' 'Check user, password and database name in Backup -> Backup settings.')" 18
        return 1
    fi
    {
        echo "$(L 'DB 백업이 끝났습니다.' 'DB backup finished.')  ($(L '걸린 시간' 'elapsed') ${BK_DB_SECS}$(L '초' 's'))"
        echo
        for f in "${BK_DB_MADE[@]}"; do
            echo "  $f  ($(du -h -- "$f" 2>/dev/null | cut -f1))"
        done
        echo
        if (( BK_DB_KEEP_DAYS > 0 )); then
            echo "$(L '보관 기간' 'Retention') ${BK_DB_KEEP_DAYS}$(L '일이 지난 백업' ' days — expired backups removed'): ${BK_DB_REMOVED}$(L '개 삭제' '')"
        fi
        echo
        echo "$(L '복구할 때' 'To restore'):"
        if [[ "$BK_DB_COMPRESS" == yes ]]; then
            echo "  gunzip -c <$(L '파일' 'file')> | $BK_DB_HOME/bin/mariadb -u $BK_DB_USER -p <DB>"
        else
            echo "  $BK_DB_HOME/bin/mariadb -u $BK_DB_USER -p <DB> < <$(L '파일' 'file')>"
        fi
    } >"$TMP_OUT"
    msg "$(L 'DB 백업 — 성공' 'DB backup — OK')" "$(cat "$TMP_OUT")" 16
}

# --- scheduled DB backup (systemd timer) ---------------------------------------
# safetui does not need to keep running. At the set time systemd runs 'safetui --db-backup'
# once and it exits. A run missed while the server was off happens once after boot (Persistent).
bk_dow_label() {
    case "$1" in
        Mon) L '월요일' 'Monday' ;;   Tue) L '화요일' 'Tuesday' ;; Wed) L '수요일' 'Wednesday' ;;
        Thu) L '목요일' 'Thursday' ;; Fri) L '금요일' 'Friday' ;;  Sat) L '토요일' 'Saturday' ;;
        Sun) L '일요일' 'Sunday' ;;
    esac
}
bk_sched_label() {
    case "$BK_SCHED" in
        daily)   echo "$(L '매일' 'Every day') $BK_SCHED_TIME" ;;
        weekly)  echo "$(L '매주' 'Every') $(bk_dow_label "$BK_SCHED_DOW") $BK_SCHED_TIME" ;;
        monthly) if [[ "$BK_SCHED_DOM" == last ]]; then echo "$(L '매월 말일' 'Monthly, last day') $BK_SCHED_TIME"
                 else echo "$(L '매월' 'Monthly, day') ${BK_SCHED_DOM}$(L '일' '') $BK_SCHED_TIME"; fi ;;
        *)       L '꺼짐' 'off' ;;
    esac
}
bk_sched_calendar() {
    case "$BK_SCHED" in
        daily)   echo "*-*-* ${BK_SCHED_TIME}:00" ;;
        weekly)  echo "${BK_SCHED_DOW} *-*-* ${BK_SCHED_TIME}:00" ;;
        # *-*~01 = last day of the month (systemd works out 28/29/30/31)
        monthly) if [[ "$BK_SCHED_DOM" == last ]]; then echo "*-*~01 ${BK_SCHED_TIME}:00"
                 else printf '*-*-%02d %s:00\n' "$((10#$BK_SCHED_DOM))" "$BK_SCHED_TIME"; fi ;;
    esac
}
# Apply the current BK_SCHED* settings to systemd (remove the units when off)
bk_sched_apply() {
    local dir="/etc/systemd/system" cal self
    cal="$(bk_sched_calendar)"
    if [[ -z "$cal" ]]; then
        systemctl disable --now "$BK_UNIT.timer" >/dev/null 2>&1
        rm -f "$dir/$BK_UNIT.timer" "$dir/$BK_UNIT.service"
        systemctl daemon-reload >/dev/null 2>&1
        return 0
    fi
    self="$(readlink -f "$0" 2>/dev/null)"; [[ -x "$self" ]] || self="/usr/bin/safetui"
    cat >"$dir/$BK_UNIT.service" <<EOF
[Unit]
Description=safetui scheduled MariaDB backup (safetui --db-backup)

[Service]
Type=oneshot
ExecStart=$self --db-backup
Nice=19
IOSchedulingClass=idle
EOF
    cat >"$dir/$BK_UNIT.timer" <<EOF
[Unit]
Description=safetui scheduled MariaDB backup timer

[Timer]
OnCalendar=$cal
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF
    chmod 644 "$dir/$BK_UNIT.service" "$dir/$BK_UNIT.timer"
    restorecon "$dir/$BK_UNIT.service" "$dir/$BK_UNIT.timer" >/dev/null 2>&1
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable "$BK_UNIT.timer" >/dev/null 2>&1
    systemctl restart "$BK_UNIT.timer" 2>"$TMP_OUT"
}
bk_sched_next() {
    local v
    systemctl is-active --quiet "$BK_UNIT.timer" 2>/dev/null || { L '(예약 없음)' '(not scheduled)'; return; }
    v="$(systemctl show "$BK_UNIT.timer" -p NextElapseUSecRealtime --value 2>/dev/null)"
    [[ -n "$v" && "$v" != "n/a" ]] && date -d "$v" '+%Y-%m-%d %H:%M (%a)' 2>/dev/null || echo "${v:-?}"
}
bk_sched_last() {
    local ts res
    ts="$(systemctl show "$BK_UNIT.service" -p ExecMainExitTimestamp --value 2>/dev/null)"
    res="$(systemctl show "$BK_UNIT.service" -p Result --value 2>/dev/null)"
    if [[ -z "$ts" || "$ts" == "n/a" ]]; then L '(아직 실행된 적 없음)' '(never run)'; return; fi
    if [[ "$res" == success ]]; then echo "$(L '성공' 'OK') — $(date -d "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null)"
    else echo "$(L '실패' 'FAILED') ($res) — $(date -d "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null)"; fi
}
bk_sched_log_text() {
    echo "$(L '자동 백업 실행 기록 (최근 것이 위)' 'Scheduled backup log (newest first)')"
    echo
    journalctl -u "$BK_UNIT.service" -n 40 -r --no-pager -o short-iso 2>&1 | sed 's/^\([0-9-]*\)T\([0-9:]*\)[^ ]* [^ ]* /\1 \2 /'
}

bk_sched() {
    local choice v
    bk_load
    while true; do
        choice="$(dlg --title "$(L 'DB 자동 백업 예약' 'Scheduled DB backup')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '정해 둔 시각에 DB 백업을 자동으로 실행합니다. (safetui 를 켜 둘 필요 없음)' 'Runs the DB backup automatically at the set time. (safetui need not stay open)')\n\n$(L '현재 예약   :' 'Schedule :') $(bk_sched_label)\n$(L '다음 실행   :' 'Next run :') $(bk_sched_next)\n$(L '마지막 실행 :' 'Last run :') $(bk_sched_last)" \
            "$DLG_H" "$DLG_W" 6 \
            1 "$(L '매일' 'Every day')" \
            2 "$(L '매주 (요일 선택)' 'Every week (pick a weekday)')" \
            3 "$(L '매월 (날짜 또는 말일)' 'Every month (a day or the last day)')" \
            4 "$(L '예약 끄기' 'Turn schedule off')" \
            5 "$(L '실행 기록 보기' 'View run log')")" || return
        case "$choice" in
            5) show_text "$(L '자동 백업 실행 기록' 'Scheduled backup log')" bk_sched_log_text; continue ;;
            4) if [[ "$BK_SCHED" == off ]] && ! systemctl is-enabled --quiet "$BK_UNIT.timer" 2>/dev/null; then
                   msg "$(L 'DB 자동 백업 예약' 'Scheduled DB backup')" "$(L '예약이 이미 꺼져 있습니다.' 'The schedule is already off.')" 7; continue
               fi
               BK_SCHED="off"; bk_save; bk_sched_apply
               msg "$(L '예약 끄기 — 성공' 'Schedule off — OK')" "$(L 'DB 자동 백업 예약을 껐습니다. 이미 받아 둔 백업 파일은 그대로 있습니다.' 'Scheduled DB backup is off. Existing backup files are kept.')" 8
               continue ;;
            2) v="$(dlg --title "$(L '요일 선택' 'Pick a weekday')" --default-item "$BK_SCHED_DOW" \
                    --menu "$(L '매주 무슨 요일에 백업할까요?' 'Which weekday?')" 15 "$DLG_W" 7 \
                    Mon "$(bk_dow_label Mon)" Tue "$(bk_dow_label Tue)" Wed "$(bk_dow_label Wed)" Thu "$(bk_dow_label Thu)" \
                    Fri "$(bk_dow_label Fri)" Sat "$(bk_dow_label Sat)" Sun "$(bk_dow_label Sun)")" || continue
               BK_SCHED_DOW="$v" ;;
            3) v="$(dlg --title "$(L '날짜 선택' 'Pick a day')" --default-item "$( [[ "$BK_SCHED_DOM" == last ]] && echo last || echo day )" \
                    --menu "$(L '매월 언제 백업할까요?' 'When in the month?')" 11 "$DLG_W" 2 \
                    day  "$(L '날짜를 지정 (1~28일)' 'A specific day (1-28)')" \
                    last "$(L '매월 말일 (28·29·30·31일 중 그 달의 마지막 날)' 'Last day of each month')")" || continue
               if [[ "$v" == last ]]; then BK_SCHED_DOM="last"
               else
                   v="$(dlg_input "$(L '날짜 선택' 'Pick a day')" \
                        "$(L '매월 며칠에 백업할까요? (1~28)\n29~31일은 없는 달이 있어 받지 않습니다. 월말에 받으려면 "매월 말일"을 고르세요.' 'Which day of the month? (1-28)\nDays 29-31 do not exist in every month; use "Last day" instead.')" \
                        "$( [[ "$BK_SCHED_DOM" == last ]] && echo 1 || echo "$BK_SCHED_DOM" )")" || continue
                   if [[ "$v" =~ ^([1-9]|1[0-9]|2[0-8])$ ]]; then BK_SCHED_DOM="$v"
                   else msg "$(L '입력 오류' 'Invalid input')" "$(L '1~28 사이 숫자를 입력하세요.' 'Enter a number between 1 and 28.')" 8; continue; fi
               fi ;;
        esac
        v="$(dlg_input "$(L '실행 시각' 'Time of day')" \
            "$(L '몇 시 몇 분에 백업할까요? 24시간 형식 HH:MM 으로 입력하세요.\n예) 03:00  (이용자가 적은 새벽 시간을 권장)' 'What time? Use 24-hour HH:MM.\ne.g. 03:00  (a quiet hour is recommended)')" "$BK_SCHED_TIME")" || continue
        if [[ ! "$v" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
            msg "$(L '입력 오류' 'Invalid input')" "$(L '시각은 HH:MM 형식(00:00~23:59)으로 입력하세요.' 'Enter the time as HH:MM (00:00-23:59).')" 8; continue
        fi
        BK_SCHED_TIME="$v"
        case "$choice" in 1) BK_SCHED="daily" ;; 2) BK_SCHED="weekly" ;; 3) BK_SCHED="monthly" ;; esac
        bk_save
        if bk_sched_apply && systemctl is-active --quiet "$BK_UNIT.timer"; then
            BK_DUMP="$(bk_dump_bin)" || v="\n\n$(L '[주의] 지금 설정된 경로에서 MariaDB 를 찾지 못했습니다. 백업 설정을 확인하세요.' '[CAUTION] MariaDB was not found under the configured path. Check Backup settings.')"
            [[ -n "${BK_DUMP:-}" ]] && v=""
            msg "$(L '예약 — 성공' 'Schedule — OK')" \
"$(L 'DB 자동 백업을 예약했습니다.' 'Scheduled DB backup is set.')\n\n$(L '예약      :' 'Schedule :') $(bk_sched_label)\n$(L '다음 실행 :' 'Next run :') $(bk_sched_next)\n$(L '저장 위치 :' 'Folder   :') $BK_DB_DIR\n\n$(L '서버가 꺼져 있어 시각을 놓치면, 켜진 뒤 한 번 실행합니다.\n백업 대상·계정·보관 기간은 백업 설정의 값을 그대로 씁니다.' 'If the server is off at that time, the backup runs once after boot.\nDatabase, user and retention come from Backup settings.')${v}" 17
        else
            msg "$(L '예약 — 실패' 'Schedule — Failed')" "$(L '타이머를 등록하지 못했습니다.' 'Could not register the timer.')\n\n$(cat "$TMP_OUT")" 12
        fi
    done
}

bk_db_list_text() {
    local f
    echo "$(L '위치' 'Folder'): $BK_DB_DIR"
    echo
    ( cd "$BK_DB_DIR" 2>/dev/null && ls -1t -- *.sql.gz *.sql 2>/dev/null ) | while IFS= read -r f; do
        printf '%s  %6s  %s\n' "$(date -r "$BK_DB_DIR/$f" '+%Y-%m-%d %H:%M')" "$(du -h -- "$BK_DB_DIR/$f" | cut -f1)" "$f"
    done
    echo
    echo "$(L '남은 공간' 'Free space'): $(df -h --output=avail -- "$BK_DB_DIR" | tail -n 1 | tr -d ' ')"
    if (( BK_DB_KEEP_DAYS > 0 )); then
        echo "$(L '보관 기간' 'Retention'): ${BK_DB_KEEP_DAYS}$(L '일 (다음 DB 백업이 성공하면 지난 파일 삭제)' ' days (expired files are removed after the next successful DB backup)')"
    fi
    echo "$(L '자동 백업' 'Schedule'): $(bk_sched_label)"
}

bk_db_list() {
    bk_load
    if [[ ! -d "$BK_DB_DIR" ]] || ! compgen -G "$BK_DB_DIR/*.sql*" >/dev/null; then
        msg "$(L 'DB 백업 목록' 'DB backups')" "$(L '아직 DB 백업이 없습니다.' 'No DB backups yet.')\n\n  $BK_DB_DIR" 9; return
    fi
    show_text "$(L 'DB 백업 목록' 'DB backups')" bk_db_list_text
}

backup_menu() {
    local choice
    bk_load
    while true; do
        choice="$(dlg --title "$(L '백업' 'Backup')" --cancel-label "$(L '뒤로' 'Back')" \
            --menu "$(L '설정 파일을 고치기 전이나 작업 전에 백업을 받아 두세요.' 'Take a backup before editing config files or starting work.')" \
            "$DLG_H" "$DLG_W" "$MENU_H" \
            1 "$(L '파일·폴더 백업 (골라서 복사)' 'Back up files/folders')" \
            2 "$(L '파일·폴더 백업 이력 보기' 'File backup history')" \
            3 "$(L 'DB 백업 (MariaDB 덤프)' 'Back up database (MariaDB dump)')" \
            4 "$(L 'DB 백업 목록 보기' 'List DB backups')" \
            5 "$(L 'DB 자동 백업 예약' 'Scheduled DB backup') [$(bk_sched_label)]" \
            6 "$(L '백업 설정' 'Backup settings')")" || return
        case "$choice" in
            1) bk_files ;;
            2) bk_hist ;;
            3) bk_db ;;
            4) bk_db_list ;;
            5) bk_sched ;;
            6) bk_settings ;;
        esac
    done
}

